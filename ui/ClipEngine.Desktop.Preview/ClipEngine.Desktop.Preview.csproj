<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the real app windows with sample data to PNGs, on any OS. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipEngine.Desktop\ClipEngine.Desktop.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <None Include="SampleThumbnails\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
