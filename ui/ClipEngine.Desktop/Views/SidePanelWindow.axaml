<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClipEngine.Desktop.ViewModels"
        xmlns:views="using:ClipEngine.Desktop.Views"
        x:Class="ClipEngine.Desktop.Views.SidePanelWindow"
        x:DataType="vm:MainViewModel"
        Title="Clip Engine side panel"
        Icon="avares://ClipEngine/Assets/ClipEngine.ico"
        Width="344" Height="760"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent, None">
  <!-- A slim panel that sits on the edge of the screen above the game, toggled by its hotkey. -->
  <views:Plate Name="Card" Margin="12" Cut="16" BorderBrush="{StaticResource BorderStrongBrush}"
               Background="{StaticResource OverlayBrush}" Marker="{DynamicResource AccentBrush}">
    <DockPanel Margin="16,16,16,14">
      <!-- Header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="2,0,0,16">
        <views:Plate Width="32" Height="32" Cut="7" Background="{DynamicResource AccentBrush}">
          <PathIcon Data="{StaticResource IconPlay}" Width="17" Height="17" Foreground="{DynamicResource AccentForegroundBrush}"
                    Margin="2,0,0,0" />
        </views:Plate>
        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
          <TextBlock Text="CLIP ENGINE" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14" LetterSpacing="1.4" />
          <TextBlock Classes="caption" Text="{Binding SidePanelHotkey, StringFormat='{}{0} hides this panel'}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="icon" Width="30" Height="30" CornerRadius="7" Command="{Binding ToggleSidePanelCommand}"
                ToolTip.Tip="Hide">
          <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
        </Button>
      </Grid>

      <!-- Status and the save button -->
      <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,18">
        <Border Classes="inset" Padding="12,10">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <Panel Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
              <Ellipse Fill="{Binding StatusBrush}" Classes="liveDot" Classes.pulsing="{Binding IsRecording}" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusDetail}" Classes="caption" Margin="0,3,0,0"
                       TextWrapping="Wrap" MaxLines="2" />
          </Grid>
        </Border>
        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding SaveClipCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconBolt}" Width="14" Height="14" />
            <TextBlock Text="SAVE CLIP" LetterSpacing="1" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Classes="caption" Text="{Binding SaveHint}" HorizontalAlignment="Center" />
      </StackPanel>

      <Button DockPanel.Dock="Bottom" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Command="{Binding ShowMainWindowCommand}" Margin="0,12,0,0">
        <TextBlock Text="Open Clip Engine" />
      </Button>

      <ScrollViewer>
        <StackPanel Spacing="8">
          <TextBlock Classes="eyebrow" Text="JUST DETECTED" IsVisible="{Binding HasRecentMoments}" Margin="2,0,0,0" />
          <ItemsControl ItemsSource="{Binding RecentMoments}" IsVisible="{Binding HasRecentMoments}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityItem">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,3">
                  <PathIcon Data="{StaticResource IconSparkle}" Width="11" Height="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Time}" Classes="caption" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="eyebrow" Text="LATEST CLIPS" Margin="2,0,0,0" />
          <TextBlock Classes="caption" Text="Clips you save show up here." IsVisible="{Binding HasNoClips}" Margin="2,0,0,0" />
          <ItemsControl ItemsSource="{Binding RecentClips}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ClipItemViewModel">
                <Button Classes="marker" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="6" Margin="0,0,0,4">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="104" Height="58" CornerRadius="0" ClipToBounds="True" Background="{Binding Placeholder}">
                      <Panel>
                        <views:GameBadge Game="{Binding Game}" Wide="True" InitialsSize="18" CornerRadius="0"
                                         IsVisible="{Binding !HasThumbnail}" />
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                        <Border Classes="pill onMedia" Padding="5,1" Margin="4"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding HasDuration}">
                          <TextBlock Text="{Binding Duration}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Game}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding When}" Classes="caption" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Summary}" Classes="caption" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding HasSummary}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </views:Plate>
</Window>
