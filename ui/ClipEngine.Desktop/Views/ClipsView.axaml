<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             xmlns:views="using:ClipEngine.Desktop.Views"
             x:Class="ClipEngine.Desktop.Views.ClipsView"
             x:DataType="vm:ClipsPage">
  <DockPanel Margin="18,0,22,0">
    <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="h1" Text="Clips" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="caption" Text="{Binding Main.ClipCount, StringFormat='{}{0} saved'}" />
            <TextBlock Classes="caption" Text="·" />
            <TextBlock Classes="caption" Text="{Binding Main.LibrarySize}" />
          </StackPanel>
        </StackPanel>
        <TextBox Grid.Column="1" Width="260" Watermark="Search clips" Text="{Binding Main.Search}"
                 VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="12,0,0,0"
                      Foreground="{StaticResource TextTertiary}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button Grid.Column="2" Classes="glass" Command="{Binding Main.OpenClipsFolderCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" />
            <TextBlock Text="Open folder" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <ListBox Classes="chips" ItemsSource="{Binding Main.Filters}" SelectedItem="{Binding Main.Filter}" />
    </StackPanel>

    <Panel>
      <ScrollViewer IsVisible="{Binding Main.HasFilteredClips}">
        <ItemsControl ItemsSource="{Binding Main.FilteredClips}" Margin="0,0,0,24" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ClipItemViewModel">
              <views:ClipCard Margin="0,0,14,14" ThumbnailHeight="168" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Classes="glass" Padding="40" VerticalAlignment="Top" IsVisible="{Binding !Main.HasFilteredClips}">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Border Width="56" Height="56" CornerRadius="18" Background="{StaticResource AccentGradient}"
                  HorizontalAlignment="Center" BoxShadow="{StaticResource AccentGlow}">
            <PathIcon Data="{StaticResource IconClips}" Width="24" Height="24" Foreground="White" />
          </Border>
          <TextBlock Classes="h2" Text="Nothing here yet" HorizontalAlignment="Center" />
          <TextBlock Classes="body" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     Text="Clips you save while playing show up here, grouped by game." />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
