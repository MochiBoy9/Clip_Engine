<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             xmlns:views="using:ClipEngine.Desktop.Views"
             x:Class="ClipEngine.Desktop.Views.ClipsView"
             x:DataType="vm:ClipsPage">
  <DockPanel Margin="0">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="h1" Text="Clips" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="caption" Text="{Binding Main.ClipCount, StringFormat='{}{0} saved'}" />
            <TextBlock Classes="caption" Text="·" />
            <TextBlock Classes="caption" Text="{Binding Main.StorageText}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Classes="segment" GroupName="clipsView" IsChecked="{Binding Main.ShowClipsGrid, Mode=OneWay}"
                         Command="{Binding Main.ShowClipsGridCommand}" ToolTip.Tip="Every clip on its own">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconGrid}" Width="12" Height="12" />
                <TextBlock Text="Clips" />
              </StackPanel>
            </RadioButton>
            <RadioButton Classes="segment" GroupName="clipsView" IsChecked="{Binding Main.ShowMatches, Mode=OneWay}"
                         Command="{Binding Main.ShowMatchesCommand}" ToolTip.Tip="Clips grouped by match, with the whole match's moments">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconMatches}" Width="12" Height="12" />
                <TextBlock Text="Matches" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
        <TextBox Grid.Column="2" Width="240" Watermark="Search clips, like &quot;revive&quot;" Text="{Binding Main.Search}"
                 VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="12,0,0,0"
                      Foreground="{StaticResource TextTertiary}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button Grid.Column="3" Classes="secondary" Command="{Binding Main.ImportClipCommand}" VerticalAlignment="Center"
                Margin="0,0,10,0" ToolTip.Tip="Add a clip someone sent you. You can also drop it on the window.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconImport}" Width="15" Height="15" />
            <TextBlock Text="Import" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Classes="secondary" Command="{Binding Main.OpenClipsFolderCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" />
            <TextBlock Text="Open folder" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <ListBox Classes="chips" ItemsSource="{Binding Main.Filters}" SelectedItem="{Binding Main.Filter}" />
    </StackPanel>

    <Panel>
      <ScrollViewer>
        <ScrollViewer.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="Main.HasFilteredClips" />
            <Binding Path="Main.ShowClipsGrid" />
          </MultiBinding>
        </ScrollViewer.IsVisible>
        <ItemsControl ItemsSource="{Binding Main.FilteredClips}" Margin="0,0,0,24" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ClipItemViewModel">
              <views:ClipCard Margin="0,0,12,12" ThumbnailHeight="168" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Matches: each one's result, totals, moments and best clips -->
      <ScrollViewer>
        <ScrollViewer.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="Main.HasMatches" />
            <Binding Path="Main.ShowMatches" />
          </MultiBinding>
        </ScrollViewer.IsVisible>
        <ItemsControl ItemsSource="{Binding Main.Matches}" Margin="0,0,12,24">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MatchViewModel">
              <views:Plate Classes="card" Padding="16" Margin="0,0,0,12">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="44" Height="44" CornerRadius="2" Background="{Binding Gradient}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="Black" Foreground="#E6FFFFFF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="h2" Text="{Binding Title}" />
                        <Border Classes="pill" Padding="9,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Game}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Classes="pill accent" Padding="9,2" VerticalAlignment="Center" IsVisible="{Binding HasResult}">
                          <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="Bold" LetterSpacing="0.6" />
                        </Border>
                      </StackPanel>
                      <TextBlock Classes="caption" Text="{Binding Caption}" />
                    </StackPanel>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Stats}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MatchStat">
                          <StackPanel Spacing="1" MinWidth="44">
                            <TextBlock Classes="mono" Text="{Binding Value}" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                              <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center" />
                              <TextBlock Classes="caption" Text="{Binding Label}" />
                            </StackPanel>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <views:EventRibbon Ticks="{Binding Ribbon}" Height="14" IsVisible="{Binding HasMoments}"
                                     ToolTip.Tip="Every moment of the match, in order" />
                  <ItemsControl ItemsSource="{Binding BestClips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ClipItemViewModel">
                        <views:ClipCard Margin="0,0,10,0" ThumbnailHeight="132" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </views:Plate>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <views:Plate Classes="card" Padding="40" VerticalAlignment="Top" IsVisible="{Binding !Main.HasFilteredClips}">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Border Classes="tile" Width="48" Height="48" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource IconClips}" Width="22" Height="22" />
          </Border>
          <TextBlock Classes="h2" Text="Nothing here yet" HorizontalAlignment="Center" />
          <TextBlock Classes="body" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     Text="Clips you save while playing show up here, grouped by game." />
        </StackPanel>
      </views:Plate>
    </Panel>
  </DockPanel>
</UserControl>
