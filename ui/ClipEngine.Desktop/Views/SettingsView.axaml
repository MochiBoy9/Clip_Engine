<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ClipEngine.Desktop.Views"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             x:Class="ClipEngine.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.caption.error">
      <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
    </Style>
    <Style Selector="RadioButton.swatch">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Ring" Padding="3" CornerRadius="2" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="RadioButton.swatch:checked /template/ Border#Ring">
      <Setter Property="BorderBrush" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="RadioButton.swatch:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.offer.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.credit.ultra">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{x:Null}" />
    </Style>
    <Style Selector="Border.credit.ultra TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <!-- A track's mute and volume, which apply at once, even mid-game -->
    <DataTemplate DataType="vm:AudioTrackViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding IsRecorded}">
        <ToggleButton Classes="chip" IsChecked="{Binding IsMuted}" VerticalAlignment="Center" Margin="0,0,14,0"
                      ToolTip.Tip="Keep this track out of clips until you unmute it">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconVolume}" Width="12" Height="12" />
            <TextBlock Text="Mute" />
          </StackPanel>
        </ToggleButton>
        <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Volume}" IsEnabled="{Binding !IsMuted}"
                SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
        <Border Grid.Column="2" Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="{Binding VolumeText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <DockPanel Margin="0">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,40,22">
      <StackPanel VerticalAlignment="Center" Spacing="4">
        <views:SectionMark Index="09" Label="System config" />
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="caption" Text="{Binding SavedMessage, TargetNullValue='Recording changes apply when you save; the engine restarts in a second.'}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary" Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,10,0"
              VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="accent" Content="Save changes" Command="{Binding SaveCommand}"
              VerticalAlignment="Center" />
    </Grid>
    <ScrollViewer>
      <Grid ColumnDefinitions="1.25*,22,*" Margin="0,0,40,40">
        <StackPanel>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="RECORDING" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Replay buffer" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="{Binding BufferHint}" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="10" Maximum="{Binding MaxBufferSeconds}" Value="{Binding BufferSeconds}"
                          SmallChange="10" LargeChange="60" TickFrequency="10" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BufferText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Margin="56,12,0,0" IsVisible="{Binding HasBufferWarning}">
              <PathIcon Data="{StaticResource IconAlert}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,8,0"
                        Foreground="{StaticResource RecordBrush}" />
              <TextBlock Grid.Column="1" Classes="caption error" Text="{Binding BufferWarning}" TextWrapping="Wrap" />
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconBolt}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Clip length" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="How much of the buffer a saved clip keeps." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="5" Maximum="{Binding BufferSeconds}" Value="{Binding ClipSeconds}"
                          SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClipText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconMonitor}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Frame rate" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Match monitor records at your refresh rate, up to 120 fps, which keeps recording light on the game. Pick a higher rate to record faster." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ComboBox Width="190" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Fps}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconMonitor}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Resolution" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="{Binding ResolutionHint}" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ComboBox Width="210" ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding Resolution}">
                  <ComboBox.Styles>
                    <Style Selector="ComboBoxItem" x:DataType="vm:ResolutionOption">
                      <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                    </Style>
                  </ComboBox.Styles>
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResolutionOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconDrive}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Bitrate" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Auto picks one from resolution and frame rate." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="0" Maximum="150" Value="{Binding Bitrate}"
                          SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BitrateText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconClips}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Codec" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Auto uses H.264, and HEVC when the resolution needs it." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Border Classes="segments">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="segment" GroupName="codec" Content="Auto" IsChecked="{Binding CodecAuto}" />
                    <RadioButton Classes="segment" GroupName="codec" Content="H.264" IsChecked="{Binding CodecH264}" />
                    <RadioButton Classes="segment" GroupName="codec" Content="HEVC" IsChecked="{Binding CodecHevc}" />
                  </StackPanel>
                </Border>
              </Panel>
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,8" Text="AUDIO" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,0,0,18"
                       Text="Each source has a track of its own, after one with them all mixed that every player plays. Volume and mute change right away, even mid-game; turning a track on or off applies when you save." />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconGames}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Game" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Only the game, quiet while you're in another window. On Windows older than version 2004 it's everything you hear." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding GameTrack.IsRecorded}" OnContent="{x:Null}" OffContent="{x:Null}"
                              ToolTip.Tip="Record this track" />
              </Panel>
            </Grid>
            <ContentControl Content="{Binding GameTrack}" Margin="56,12,0,0" />
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconMic}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Microphone" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Your voice. Muted, it's kept out of clips, and voice clips still hear you." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding MicTrack.IsRecorded}" OnContent="{x:Null}" OffContent="{x:Null}"
                              ToolTip.Tip="Record this track" />
              </Panel>
            </Grid>
            <ContentControl Content="{Binding MicTrack}" Margin="56,12,0,0" />
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconSquad}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Discord" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Discord calls, and TeamSpeak or Mumble, so squad chat can be turned down on its own." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding DiscordTrack.IsRecorded}" OnContent="{x:Null}" OffContent="{x:Null}"
                              ToolTip.Tip="Record this track" />
              </Panel>
            </Grid>
            <ContentControl Content="{Binding DiscordTrack}" Margin="56,12,0,0" />
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconGrid}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Other apps" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Music, videos and anything else that plays, quiet while you're in another window." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding AppsTrack.IsRecorded}" OnContent="{x:Null}" OffContent="{x:Null}"
                              ToolTip.Tip="Record this track" />
              </Panel>
            </Grid>
            <ContentControl Content="{Binding AppsTrack}" Margin="56,12,0,0" />
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="VOICE CLIPS" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconMic}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Clip by voice" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Say a phrase and the last moments are saved, like pressing a clip key. Windows' own speech recognition listens on this PC, and nothing you say leaves it." />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding VoiceClips}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <StackPanel IsEnabled="{Binding VoiceClips}">
              <Grid ColumnDefinitions="Auto,*">
                <Border Classes="tile" VerticalAlignment="Top" Margin="0,0,16,0">
                  <PathIcon Data="{StaticResource IconKeyboard}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Phrases" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Separate them with commas. A number after one gives its clip a length of its own, like save the last minute 60." />
                  </StackPanel>
                  <TextBox Text="{Binding VoicePhrasesText}" Watermark="clip that" />
                  <TextBlock Classes="caption error" Text="{Binding VoicePhrasesProblem}" TextWrapping="Wrap"
                             IsVisible="{Binding VoicePhrasesProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="caption" Text="{Binding VoicePhrasesAdvice}" TextWrapping="Wrap"
                             IsVisible="{Binding VoicePhrasesAdvice, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Grid>
              <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                  <PathIcon Data="{StaticResource IconBolt}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="Clip length" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Classes="caption" Text="How much a phrase saves, unless it has its own length. All the way left uses your clip length." TextWrapping="Wrap" />
                </StackPanel>
                <Panel Grid.Column="2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Width="200" Minimum="0" Maximum="{Binding BufferSeconds}" Value="{Binding VoiceClipSeconds}"
                            SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" />
                    <Border Classes="inset" Width="92" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                      <TextBlock Text="{Binding VoiceClipText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                    </Border>
                  </StackPanel>
                </Panel>
              </Grid>
              <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                  <PathIcon Data="{StaticResource IconTarget}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="Sensitivity" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Classes="caption" Text="{Binding VoiceSensitivityHint}" TextWrapping="Wrap" />
                </StackPanel>
                <Panel Grid.Column="2" VerticalAlignment="Center">
                  <Border Classes="segments">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <RadioButton Classes="segment" GroupName="voice" Content="Low" IsChecked="{Binding VoiceLow}" />
                      <RadioButton Classes="segment" GroupName="voice" Content="Medium" IsChecked="{Binding VoiceMedium}" />
                      <RadioButton Classes="segment" GroupName="voice" Content="High" IsChecked="{Binding VoiceHigh}" />
                    </StackPanel>
                  </Border>
                </Panel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="AUTOMATIC CLIPS" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconSparkle}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Detect moments" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Reads kills, assists, revives and more off the screen while you play." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding Detection}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <StackPanel Spacing="0" IsEnabled="{Binding Detection}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconSparkle}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Reading quality" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="{Binding ReadingQualityHint}" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Border Classes="segments">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="segment" GroupName="quality" Content="Low" IsChecked="{Binding QualityLow}" />
                    <RadioButton Classes="segment" GroupName="quality" Content="Medium" IsChecked="{Binding QualityMedium}" />
                    <RadioButton Classes="segment" GroupName="quality" Content="High" IsChecked="{Binding QualityHigh}" />
                    <RadioButton Classes="segment" GroupName="quality" Content="Ultra" IsChecked="{Binding QualityUltra}" />
                  </StackPanel>
                </Border>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconRecord}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Save clips by themselves" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="A clip is saved around every moment you pick below, no hotkey needed." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding AutoClip}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconJournal}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Keep a journal of each run" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="In ARC Raiders, Escape from Tarkov, Hunt: Showdown 1896, Helldivers 2 and Deep Rock Galactic: the map, enemies destroyed, loot, and whether you made it out. See it on the Journal page." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding Journal}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <StackPanel IsEnabled="{Binding AutoClip}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Before the moment" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Gameplay kept from before it happened." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="0" Maximum="60" Value="{Binding ClipBeforeSeconds}"
                          SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClipBeforeText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="After the moment" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Moments close together end up in one clip." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="0" Maximum="30" Value="{Binding ClipAfterSeconds}"
                          SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClipAfterText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <TextBlock Text="Clip these moments" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding AutoClipEvents}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EventToggle">
                  <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,8,8" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            </StackPanel>
          </StackPanel>
        </views:Plate>
        </StackPanel>
        <StackPanel Grid.Column="2">
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22" DataContext="{Binding Plan}" x:DataType="vm:PlanViewModel"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="PLAN" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconSparkle}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                  <Border Classes="pill accent" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding ShowBadge}">
                    <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" LetterSpacing="1" />
                  </Border>
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding Reason}" IsVisible="{Binding HasReason}" TextWrapping="Wrap" FontStyle="Italic" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Button Classes="secondary" Content="Manage" Command="{Binding ManageCommand}" IsVisible="{Binding HasManage}" />
              </Panel>
            </Grid>
            <TextBlock Classes="caption error" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <Grid ColumnDefinitions="*,12,*" Margin="0,16,0,0">
              <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding Offers}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlanOffer">
                    <Border Classes="inset offer" Classes.current="{Binding IsCurrent}" Padding="14,12" Margin="0,0,6,0" CornerRadius="2">
                      <DockPanel>
                        <Button DockPanel.Dock="Bottom" Classes="accent" Classes.secondary="{Binding !IsUltra}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Content="{Binding ButtonText}" Command="{Binding SubscribeCommand}" Margin="0,12,0,0" />
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="markLabel" Text="{Binding Label}" FontSize="13" />
                            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding PriceText}" FontSize="12" FontWeight="Bold" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Perks}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                  <Border Width="5" Height="5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,6,8,0" />
                                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <Border Classes="inset" Padding="14,12" Margin="0,12,0,0" CornerRadius="2">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="markLabel" Text="Support Clip Engine" FontSize="13" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="ANY AMOUNT" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                </Grid>
                <TextBlock Classes="caption" Text="{Binding DonateCaption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{Binding DonationPerks}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <Border Width="5" Height="5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,6,8,0" />
                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding DonateOptions}" Margin="0,10,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DonateOption">
                      <Button Classes="accent" Classes.secondary="{Binding !IsAny}" Content="{Binding Label}" Command="{Binding DonateCommand}"
                              Margin="0,0,8,8" MinWidth="64" HorizontalContentAlignment="Center" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption" Text="{Binding DonateStatus}" IsVisible="{Binding HasDonateStatus}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding DonateHint}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding ShowKeyBox}">
              <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
              <TextBlock Text="License key" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Classes="caption" Text="Subscribing or donating emails you a key. Paste it, or a special key (CEK-...), here on each PC you play on."
                         TextWrapping="Wrap" Margin="0,2,0,12" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding KeyInput}" Watermark="Your license key or special key" />
                <Button Grid.Column="1" Classes="accent" Content="Activate" Command="{Binding ActivateCommand}" Margin="10,0,0,0" />
              </Grid>
            </StackPanel>
            <StackPanel IsVisible="{Binding CanBeCredited}">
              <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,16,0">
                  <TextBlock Text="Name in the credits" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Classes="caption" Text="{Binding CreditCaption}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding InCredits}" OnContent="" OffContent="" VerticalAlignment="Center" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0" IsVisible="{Binding InCredits}">
                <TextBox Text="{Binding CreditInput}" Watermark="The name to show" MaxLength="40" />
                <Button Grid.Column="1" Classes="secondary" Content="Save name" Command="{Binding SaveCreditCommand}" Margin="10,0,0,0" />
              </Grid>
            </StackPanel>
            <StackPanel IsVisible="{Binding HasContact}">
              <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
              <TextBlock Text="{Binding ContactTitle}" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Classes="caption" Text="{Binding ContactCaption}" TextWrapping="Wrap" Margin="0,2,0,10" />
              <TextBox Text="{Binding ContactInput}" Watermark="Write to the developer" MaxLength="2000" AcceptsReturn="True"
                       TextWrapping="Wrap" MinHeight="72" MaxHeight="180" />
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Classes="accent" Content="Send message" Command="{Binding SendMessageCommand}" IsVisible="{Binding HasDirectLine}" />
                <Button Classes="secondary" Content="Send bug report" Command="{Binding SendBugCommand}" IsVisible="{Binding HasBugReports}" />
              </StackPanel>
              <TextBlock Classes="caption" Text="{Binding ContactMessage}" IsVisible="{Binding HasContactMessage}" TextWrapping="Wrap"
                         Margin="0,10,0,0" Classes.error="{Binding ContactIsError}" />
              <ItemsControl ItemsSource="{Binding ContactMessages}" IsVisible="{Binding HasContactMessages}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContactMessageView">
                    <Border Classes="inset" CornerRadius="2" Padding="12,10" Margin="0,0,0,8">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="mono caption" Text="{Binding Kind}" FontSize="10" FontWeight="Bold" LetterSpacing="1" />
                          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Sent}" FontSize="11" />
                        </Grid>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="10,2,0,2" Margin="0,4,0,0"
                                IsVisible="{Binding HasReply}">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="The developer answered" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" FontSize="13" />
                          </StackPanel>
                        </Border>
                        <TextBlock Classes="caption" Text="{Binding Status}" FontSize="11" IsVisible="{Binding !HasReply}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Button Classes="secondary" Content="Remove key from this PC" Command="{Binding RemoveCommand}" IsVisible="{Binding !ShowKeyBox}"
                    Margin="0,12,0,0" />
            <TextBlock Classes="caption" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Classes.error="{Binding MessageIsError}" />
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <TextBlock Text="Colour theme" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Classes="caption" Text="{Binding ThemeCaption}" Margin="0,2,0,10" />
            <ItemsControl ItemsSource="{Binding Themes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOption">
                  <RadioButton Classes="swatch" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"
                               ToolTip.Tip="{Binding Name}" Margin="0,0,10,8">
                    <Border Width="28" Height="28" CornerRadius="1" Background="{Binding Preview}" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel IsVisible="{Binding HasCredits}">
              <Border Height="1" Background="{StaticResource Divider}" Margin="0,8,0,16" />
              <TextBlock Text="Thanks to our supporters" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Credits}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CreditName">
                    <Border Classes="inset credit" Classes.ultra="{Binding Ultra}" CornerRadius="2" Padding="10,4" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontSize="12" />
                        <TextBlock Text="{Binding Tag}" IsVisible="{Binding HasTag}" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="UPDATES" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconImport}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="{Binding AvailableTitle, TargetNullValue='Clip Engine updates'}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" Classes.error="{Binding StatusIsError}" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Button Classes="accent" Content="Install and restart" Command="{Binding InstallCommand}" IsVisible="{Binding HasUpdate}" />
                <Button Classes="secondary" Content="Check now" Command="{Binding CheckCommand}" IsVisible="{Binding !HasUpdate}" />
              </Panel>
            </Grid>
            <TextBlock Classes="caption" Text="{Binding AvailableNotes}" TextWrapping="Wrap" Margin="0,10,0,0"
                       IsVisible="{Binding AvailableNotes, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding ShowProgress}" Margin="0,10,0,0" />
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Look for updates when Clip Engine starts" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Nothing installs until you choose to." TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckOnStart}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Install from a zip" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="A Clip_Engine-windows-x64.zip you already downloaded." TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="Choose zip" Command="{Binding InstallFromZipCommand}" />
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <TextBlock Text="Release source" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,2,0,8"
                       Text="The GitHub repository updates come from. A private one needs a token that can read it (Contents: read)." />
            <TextBox Text="{Binding RepoInput}" Watermark="{Binding RepoShown}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding ShowTokenBox}">
              <TextBox Text="{Binding TokenInput}" PasswordChar="•" Watermark="GitHub token (github_pat_…)" />
              <Button Grid.Column="1" Classes="secondary" Content="Save token" Command="{Binding SaveTokenCommand}" Margin="10,0,0,0" />
            </Grid>
            <Button Classes="secondary" Content="Remove token from this PC" Command="{Binding RemoveTokenCommand}"
                    IsVisible="{Binding HasToken}" Margin="0,8,0,0" />
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="HOTKEYS" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconKeyboard}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Save hotkey" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Examples: F8, Alt+F10, Ctrl+Shift+S" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBox Width="160" Text="{Binding SaveHotkey}" HorizontalContentAlignment="Center" FontWeight="SemiBold" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="tile" VerticalAlignment="Top" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="More clip keys" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="Each key saves a clip of its own length, up to the replay buffer. The save hotkey keeps the clip length above. A game can have its own keys, set in Detection Studio." />
                </StackPanel>
                <views:ClipKeybindsEditor DataContext="{Binding MoreClipKeys}" />
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile record" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconRecord}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Long recording hotkey" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Starts a recording that keeps going until you press it again, with every moment marked on its timeline." />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBox Width="160" Text="{Binding RecordHotkey}" HorizontalContentAlignment="Center" FontWeight="SemiBold" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconMonitor}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Record without a game" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Keep a buffer of the main monitor when no game is open." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding RecordWithoutGame}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconTarget}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Record only the game" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="When you switch to another window, the video shows Game Not Found and game audio goes quiet until you're back." />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding GameFocus}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconShare}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Discord status" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Show the game you're playing, your kills and deaths and the clips you've saved on your Discord profile." />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding DiscordPresence}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="STORAGE" />
            <TextBlock Text="Clips folder" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Classes="caption" Text="One folder per game is created inside it." Margin="0,2,0,12" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding OutputDir}" Watermark="{Binding OutputDirShown}" />
              <Button Grid.Column="1" Classes="secondary" Content="Browse" Margin="10,0,0,0" Click="OnBrowse" />
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,18,0,16" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Delete old clips" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Starred clips are always kept." TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Classes="segment" GroupName="keep" Content="Never" IsChecked="{Binding KeepForever}" />
                  <RadioButton Classes="segment" GroupName="keep" Content="7 days" IsChecked="{Binding Keep7Days}" />
                  <RadioButton Classes="segment" GroupName="keep" Content="30 days" IsChecked="{Binding Keep30Days}" />
                  <RadioButton Classes="segment" GroupName="keep" Content="90 days" IsChecked="{Binding Keep90Days}" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
              <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Size limit" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Removes the oldest clips once the folder is bigger." TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Classes="segment" GroupName="limit" Content="None" IsChecked="{Binding NoSizeLimit}" />
                  <RadioButton Classes="segment" GroupName="limit" Content="50 GB" IsChecked="{Binding Limit50Gb}" />
                  <RadioButton Classes="segment" GroupName="limit" Content="100 GB" IsChecked="{Binding Limit100Gb}" />
                  <RadioButton Classes="segment" GroupName="limit" Content="250 GB" IsChecked="{Binding Limit250Gb}" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0" IsVisible="{Binding HasCleanupPreview}">
              <TextBlock Classes="caption" Text="{Binding CleanupPreview}" TextWrapping="Wrap" VerticalAlignment="Center"
                         Margin="0,0,16,0" />
              <Button Grid.Column="1" Classes="secondary" Content="Clean up now" Command="{Binding CleanUpNowCommand}"
                      ToolTip.Tip="Run the cleanup now instead of waiting" />
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="APP" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconHome}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Close to tray" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Closing the window keeps Clip Engine recording." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding CloseToTray}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconCheck}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Notice over the game" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="A small &quot;Clip saved&quot; in the corner while you play. It never shows up in your clips."
                           TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding GameNotifications}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding GameNotifications}">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconBolt}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Moments over the game" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="The same notice for each kill, multi-kill, revive and assist as it's spotted, the match's line when it ends, and a new personal best." />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding MomentNotices}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconGames}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Game pictures from Steam" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Games show their art and icons from this PC. When a picture isn't here, it's fetched once from the Steam store, which sees the game's name. Off keeps to what's on this PC." />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding GameArtOnline}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="STATS OVERLAY" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconBolt}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="FPS and PC stats over the game" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="A slim strip in a corner while you play: frame rate, 1% lows, CPU, GPU and memory. It reads what Windows already measures, never touches the game, updates once a second and never shows up in your clips." />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding StatsOverlayOn}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Classes="inset" Padding="14,12" Margin="48,14,0,0" IsVisible="{Binding FrameTimingNeedsPermission}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                  <TextBlock Text="FPS needs Windows' permission" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="Windows shares games' frame timing only with administrators and its Performance Log Users group. Allow adds this account to that group once, with Windows' own prompt. The other stats work without it." />
                  <TextBlock Classes="caption" Foreground="{StaticResource WarnBrush}" Text="{Binding FrameTimingProblem}"
                             IsVisible="{Binding HasFrameTimingProblem}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="Allow" Command="{Binding AllowFrameTimingCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="inset" Padding="14,12" Margin="48,14,0,0" IsVisible="{Binding FrameTimingNeedsSignIn}">
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Allowed. Sign out of Windows and back in (or restart) and the FPS counter starts reading." />
            </Border>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding StatsOverlayOn}">
              <Border Classes="tile" VerticalAlignment="Top" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconTarget}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="What it shows" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Classes="caption" Text="Numbers turn yellow, then red, when something is holding the game back." TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel>
                  <ToggleButton Classes="chip" Content="FPS" IsChecked="{Binding StatsFps}" Margin="0,0,8,8" />
                  <ToggleButton Classes="chip" Content="1% low" IsChecked="{Binding StatsLows}" Margin="0,0,8,8" />
                  <ToggleButton Classes="chip" Content="CPU" IsChecked="{Binding StatsCpu}" Margin="0,0,8,8" />
                  <ToggleButton Classes="chip" Content="GPU" IsChecked="{Binding StatsGpu}" Margin="0,0,8,8" />
                  <ToggleButton Classes="chip" Content="GPU temperature" IsChecked="{Binding StatsGpuTemp}" Margin="0,0,8,8" />
                  <ToggleButton Classes="chip" Content="Video memory" IsChecked="{Binding StatsVram}" Margin="0,0,8,8" />
                  <ToggleButton Classes="chip" Content="RAM" IsChecked="{Binding StatsRam}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,8,0,16" />
            <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding StatsOverlayOn}">
              <Border Classes="tile" VerticalAlignment="Top" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconMonitor}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="Corner" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Classes="caption" Text="Where it sits on the screen the game is on." TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="segments" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" GroupName="statsCorner" Content="Top left" IsChecked="{Binding StatsTopLeft}" />
                    <RadioButton Classes="segment" GroupName="statsCorner" Content="Top right" IsChecked="{Binding StatsTopRight}" />
                    <RadioButton Classes="segment" GroupName="statsCorner" Content="Bottom left" IsChecked="{Binding StatsBottomLeft}" />
                    <RadioButton Classes="segment" GroupName="statsCorner" Content="Bottom right" IsChecked="{Binding StatsBottomRight}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconKeyboard}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Overlay hotkey" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Turns the overlay on and off mid-game." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBox Width="160" Text="{Binding StatsOverlayHotkey, UpdateSourceTrigger=LostFocus}"
                         HorizontalContentAlignment="Center" FontWeight="SemiBold" />
              </Panel>
            </Grid>
            <TextBlock Classes="caption" Foreground="{StaticResource WarnBrush}" Text="{Binding StatsOverlayHotkeyProblem}"
                       IsVisible="{Binding StatsOverlayHotkeyProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Margin="48,6,0,0" />
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="26,24" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,18" Text="SIDE PANEL AND SHARING" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconPanel}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Side panel hotkey" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Shows a slim panel on the edge of the screen, over your game." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBox Width="160" Text="{Binding SidePanelHotkey, UpdateSourceTrigger=LostFocus}"
                         HorizontalContentAlignment="Center" FontWeight="SemiBold" />
              </Panel>
            </Grid>
            <TextBlock Classes="caption" Foreground="{StaticResource WarnBrush}" Text="{Binding SidePanelHotkeyProblem}"
                       IsVisible="{Binding SidePanelHotkeyProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Margin="48,6,0,0" />
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconMonitor}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Panel side" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Which edge of the screen it docks to." TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="2" Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="edge" Content="Left" IsChecked="{Binding DockLeft}" />
                  <RadioButton Classes="segment" GroupName="edge" Content="Right" IsChecked="{Binding DockRight}" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,16,0">
                <PathIcon Data="{StaticResource IconShare}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Share size" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Share to Discord makes a copy under this size. 10 MB fits free accounts, 50 MB Nitro Basic, 500 MB Nitro." TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="2" Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="share" Content="10 MB" IsChecked="{Binding Share10}" />
                  <RadioButton Classes="segment" GroupName="share" Content="50 MB" IsChecked="{Binding Share50}" />
                  <RadioButton Classes="segment" GroupName="share" Content="500 MB" IsChecked="{Binding Share500}" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </views:Plate>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
