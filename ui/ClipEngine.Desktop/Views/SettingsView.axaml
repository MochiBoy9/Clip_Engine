<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ClipEngine.Desktop.Views"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             x:Class="ClipEngine.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.caption.error">
      <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
    </Style>
    <Style Selector="RadioButton.swatch">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Ring" Padding="3" CornerRadius="2" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="RadioButton.swatch:checked /template/ Border#Ring">
      <Setter Property="BorderBrush" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="RadioButton.swatch:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="0">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="caption" Text="{Binding SavedMessage, FallbackValue='Recording changes apply when you save; the engine restarts in a second.'}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary" Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,10,0"
              VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="accent" Content="Save changes" Command="{Binding SaveCommand}"
              VerticalAlignment="Center" />
    </Grid>
    <ScrollViewer>
      <Grid ColumnDefinitions="1.25*,14,*" Margin="0,0,0,24">
        <StackPanel>
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="RECORDING" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Replay buffer" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Recent gameplay kept in memory, ready to save." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="10" Maximum="600" Value="{Binding BufferSeconds}"
                          SmallChange="10" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BufferText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconBolt}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Clip length" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="How much of the buffer a saved clip keeps." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="5" Maximum="{Binding BufferSeconds}" Value="{Binding ClipSeconds}"
                          SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClipText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconMonitor}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Frame rate" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Match monitor records at your refresh rate." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ComboBox Width="190" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Fps}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconDrive}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Bitrate" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Auto picks one from resolution and frame rate." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="0" Maximum="150" Value="{Binding Bitrate}"
                          SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BitrateText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconClips}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Codec" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Auto uses H.264, and HEVC when the resolution needs it." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Border Classes="segments">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="segment" GroupName="codec" Content="Auto" IsChecked="{Binding CodecAuto}" />
                    <RadioButton Classes="segment" GroupName="codec" Content="H.264" IsChecked="{Binding CodecH264}" />
                    <RadioButton Classes="segment" GroupName="codec" Content="HEVC" IsChecked="{Binding CodecHevc}" />
                  </StackPanel>
                </Border>
              </Panel>
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="AUDIO" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconGames}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Game audio" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Everything you hear, on its own track." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding GameAudio}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconMic}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Microphone" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Your mic on a separate track, so it can be muted later." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding MicAudio}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="AUTOMATIC CLIPS" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconSparkle}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Detect moments" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Reads kills, assists, revives and more off the screen while you play." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding Detection}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <StackPanel Spacing="0" IsEnabled="{Binding Detection}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconRecord}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Save clips by themselves" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="A clip is saved around every moment you pick below, no hotkey needed." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding AutoClip}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <StackPanel IsEnabled="{Binding AutoClip}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Before the moment" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Gameplay kept from before it happened." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="0" Maximum="60" Value="{Binding ClipBeforeSeconds}"
                          SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClipBeforeText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="After the moment" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Moments close together end up in one clip." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Slider Width="200" Minimum="0" Maximum="30" Value="{Binding ClipAfterSeconds}"
                          SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" />
                  <Border Classes="inset" Width="78" Padding="0,6" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClipAfterText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                  </Border>
                </StackPanel>
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <TextBlock Text="Clip these moments" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding AutoClipEvents}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EventToggle">
                  <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,8,8" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            </StackPanel>
          </StackPanel>
        </views:Plate>
        </StackPanel>
        <StackPanel Grid.Column="2">
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14" DataContext="{Binding Supporter}" x:DataType="vm:SupporterViewModel"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="SUPPORT" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconSparkle}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Button Classes="secondary" Content="Patreon" Command="{Binding OpenPatreonCommand}" IsVisible="{Binding HasPatreon}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <TextBlock Text="Colour theme" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Classes="caption" Text="{Binding ThemeCaption}" Margin="0,2,0,10" />
            <ItemsControl ItemsSource="{Binding Themes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOption">
                  <RadioButton Classes="swatch" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"
                               ToolTip.Tip="{Binding Name}" Margin="0,0,10,8">
                    <Border Width="28" Height="28" CornerRadius="1" Background="{Binding Preview}" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel IsVisible="{Binding KeysEnabled}">
              <Border Height="1" Background="{StaticResource Divider}" Margin="0,8,0,14" />
              <TextBlock Text="Supporter key" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Classes="caption" Text="Patrons get a key in a Patreon message. It works forever, offline, on all your PCs."
                         TextWrapping="Wrap" Margin="0,2,0,12" IsVisible="{Binding ShowKeyBox}" />
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowKeyBox}">
                <TextBox Text="{Binding KeyInput}" Watermark="CE1-…" />
                <Button Grid.Column="1" Classes="accent" Content="Activate" Command="{Binding ActivateCommand}" Margin="10,0,0,0" />
              </Grid>
              <Button Classes="secondary" Content="Remove key from this PC" Command="{Binding RemoveCommand}" IsVisible="{Binding IsSupporter}"
                      Margin="0,4,0,0" />
              <TextBlock Classes="caption" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                         Classes.error="{Binding MessageIsError}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding HasCredits}">
              <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
              <TextBlock Text="Thanks to our supporters" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Credits}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="inset" CornerRadius="10" Padding="10,4" Margin="0,0,8,8">
                      <TextBlock Text="{Binding}" FontSize="12" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="UPDATES" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconImport}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="{Binding AvailableTitle, TargetNullValue='Clip Engine updates'}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" Classes.error="{Binding StatusIsError}" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Button Classes="accent" Content="Install and restart" Command="{Binding InstallCommand}" IsVisible="{Binding HasUpdate}" />
                <Button Classes="secondary" Content="Check now" Command="{Binding CheckCommand}" IsVisible="{Binding !HasUpdate}" />
              </Panel>
            </Grid>
            <TextBlock Classes="caption" Text="{Binding AvailableNotes}" TextWrapping="Wrap" Margin="0,10,0,0"
                       IsVisible="{Binding AvailableNotes, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding ShowProgress}" Margin="0,10,0,0" />
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Look for updates when Clip Engine starts" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Nothing installs until you choose to." TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckOnStart}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Install from a zip" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="A Clip_Engine-…-windows-x64.zip you already downloaded." TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="Choose zip" Command="{Binding InstallFromZipCommand}" />
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <TextBlock Text="Release source" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,2,0,8"
                       Text="The GitHub repository updates come from. A private one needs a token that can read it (Contents: read)." />
            <TextBox Text="{Binding RepoInput}" Watermark="{Binding RepoShown}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding ShowTokenBox}">
              <TextBox Text="{Binding TokenInput}" PasswordChar="•" Watermark="GitHub token (github_pat_…)" />
              <Button Grid.Column="1" Classes="secondary" Content="Save token" Command="{Binding SaveTokenCommand}" Margin="10,0,0,0" />
            </Grid>
            <Button Classes="secondary" Content="Remove token from this PC" Command="{Binding RemoveTokenCommand}"
                    IsVisible="{Binding HasToken}" Margin="0,8,0,0" />
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="HOTKEYS" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconKeyboard}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Save hotkey" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Examples: F8, Alt+F10, Ctrl+Shift+S" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBox Width="160" Text="{Binding SaveHotkey}" HorizontalContentAlignment="Center" FontWeight="SemiBold" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile record" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconRecord}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Long recording hotkey" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Starts a recording that keeps going until you press it again, with every moment marked on its timeline." />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBox Width="160" Text="{Binding RecordHotkey}" HorizontalContentAlignment="Center" FontWeight="SemiBold" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconMonitor}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Record without a game" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Keep a buffer of the main monitor when no game is open." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding RecordWithoutGame}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="STORAGE" />
            <TextBlock Text="Clips folder" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Classes="caption" Text="One folder per game is created inside it." Margin="0,2,0,12" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding OutputDir}" Watermark="{Binding OutputDirShown}" />
              <Button Grid.Column="1" Classes="secondary" Content="Browse" Margin="10,0,0,0" Click="OnBrowse" />
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,16,0,14" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Delete old clips" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Starred clips are always kept." TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Classes="segment" GroupName="keep" Content="Never" IsChecked="{Binding KeepForever}" />
                  <RadioButton Classes="segment" GroupName="keep" Content="7 days" IsChecked="{Binding Keep7Days}" />
                  <RadioButton Classes="segment" GroupName="keep" Content="30 days" IsChecked="{Binding Keep30Days}" />
                  <RadioButton Classes="segment" GroupName="keep" Content="90 days" IsChecked="{Binding Keep90Days}" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
              <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Size limit" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Removes the oldest clips once the folder is bigger." TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Classes="segment" GroupName="limit" Content="None" IsChecked="{Binding NoSizeLimit}" />
                  <RadioButton Classes="segment" GroupName="limit" Content="50 GB" IsChecked="{Binding Limit50Gb}" />
                  <RadioButton Classes="segment" GroupName="limit" Content="100 GB" IsChecked="{Binding Limit100Gb}" />
                  <RadioButton Classes="segment" GroupName="limit" Content="250 GB" IsChecked="{Binding Limit250Gb}" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0" IsVisible="{Binding HasCleanupPreview}">
              <TextBlock Classes="caption" Text="{Binding CleanupPreview}" TextWrapping="Wrap" VerticalAlignment="Center"
                         Margin="0,0,16,0" />
              <Button Grid.Column="1" Classes="secondary" Content="Clean up now" Command="{Binding CleanUpNowCommand}"
                      ToolTip.Tip="Run the cleanup now instead of waiting" />
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="APP" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconHome}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Close to tray" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Closing the window keeps Clip Engine recording." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding CloseToTray}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconCheck}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Notice over the game" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="A small &quot;Clip saved&quot; in the corner while you play. It never shows up in your clips."
                           TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding GameNotifications}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Panel>
            </Grid>
          </StackPanel>
        </views:Plate>
        <views:Plate Classes="card" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="eyebrow" Margin="0,0,0,14" Text="SIDE PANEL AND SHARING" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconPanel}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Side panel hotkey" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Shows a slim panel on the edge of the screen, over your game." TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBox Width="160" Text="{Binding SidePanelHotkey, UpdateSourceTrigger=LostFocus}"
                         HorizontalContentAlignment="Center" FontWeight="SemiBold" />
              </Panel>
            </Grid>
            <TextBlock Classes="caption" Foreground="{StaticResource WarnBrush}" Text="{Binding SidePanelHotkeyProblem}"
                       IsVisible="{Binding SidePanelHotkeyProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Margin="48,6,0,0" />
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconMonitor}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Panel side" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Which edge of the screen it docks to." TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="2" Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="edge" Content="Left" IsChecked="{Binding DockLeft}" />
                  <RadioButton Classes="segment" GroupName="edge" Content="Right" IsChecked="{Binding DockRight}" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,12" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="tile" VerticalAlignment="Center" Margin="0,0,14,0">
                <PathIcon Data="{StaticResource IconShare}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Share size" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="caption" Text="Share to Discord makes a copy under this size. 10 MB fits free accounts, 50 MB Nitro Basic, 500 MB Nitro." TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="2" Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="share" Content="10 MB" IsChecked="{Binding Share10}" />
                  <RadioButton Classes="segment" GroupName="share" Content="50 MB" IsChecked="{Binding Share50}" />
                  <RadioButton Classes="segment" GroupName="share" Content="500 MB" IsChecked="{Binding Share500}" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </views:Plate>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
