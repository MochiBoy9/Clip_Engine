<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             xmlns:views="using:ClipEngine.Desktop.Views"
             x:Class="ClipEngine.Desktop.Views.HomeView"
             x:DataType="vm:HomePage">
  <ScrollViewer>
    <StackPanel Margin="0,0,40,40" Spacing="22">
      <views:SectionMark Index="01" Label="Engine status" Margin="0,0,0,-8" />

      <!-- What the engine is doing right now, and saving a clip -->
      <views:Plate Classes="card lead" Padding="32,28,30,28">
        <Panel>
        <views:Stripes Width="150" Height="9" Spacing="9" Fill="{DynamicResource AccentStripeBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-27,-29,0" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="10" VerticalAlignment="Center">
            <Border Classes="pill" HorizontalAlignment="Left" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Classes="liveDot" Classes.pulsing="{Binding Main.IsRecording}" Fill="{Binding Main.StatusBrush}"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding Main.StatusEyebrow}" FontSize="11" FontWeight="Bold" LetterSpacing="1.4"
                           Foreground="{StaticResource TextSecondary}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="display" Text="{Binding Main.StatusTitle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            <TextBlock Classes="body mono" Text="{Binding Main.StatusDetail}" TextWrapping="Wrap" MaxWidth="600"
                       HorizontalAlignment="Left" FontSize="13" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                        IsVisible="{Binding Main.HasEngineProblem}">
              <Button Classes="secondary" Content="Restart engine" Command="{Binding Main.RestartEngineCommand}" />
              <Button Classes="secondary" Content="Open log" Command="{Binding Main.OpenLogCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- Recording controls: save a clip, or record until stopped -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="24,0,0,0">
            <StackPanel Name="RecordingControls" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="record" Classes.active="{Binding Main.IsLongRecording}"
                      Command="{Binding Main.ToggleLongRecordingCommand}" Height="54" Padding="20,0"
                      VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource IconRecord}" Width="16" Height="16" />
                  <TextBlock Text="{Binding Main.LongRecordingButton}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Command="{Binding Main.SaveClipCommand}" Height="54" Padding="26,0"
                      VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource IconBolt}" Width="20" Height="20" />
                  <TextBlock Text="SAVE CLIP" FontSize="16" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding Main.SaveHint}" Classes="caption" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Main.LongRecordingHint}" Classes="caption" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
        </Panel>
      </views:Plate>

      <!-- Numbers at a glance -->
      <Grid ColumnDefinitions="*,18,*,18,*,18,*">
        <views:Plate Classes="card" Padding="20,18">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tile" VerticalAlignment="Center"><PathIcon Data="{StaticResource IconClock}" /></Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="stat" FontSize="22" Text="{Binding Main.BufferText}" />
              <TextBlock Classes="caption" Text="Replay buffer" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </views:Plate>
        <views:Plate Grid.Column="2" Classes="card" Padding="20,18">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tile" VerticalAlignment="Center"><PathIcon Data="{StaticResource IconClips}" /></Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="stat" FontSize="22" Text="{Binding Main.ClipsToday}" />
              <TextBlock Classes="caption" Text="Clips today" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </views:Plate>
        <views:Plate Grid.Column="4" Classes="card" Padding="20,18">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tile" VerticalAlignment="Center"><PathIcon Data="{StaticResource IconDrive}" /></Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="stat" FontSize="22" Text="{Binding Main.LibrarySize}" />
              <TextBlock Classes="caption" Text="Clip library" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </views:Plate>
        <views:Plate Grid.Column="6" Classes="card" Padding="20,18">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tile" VerticalAlignment="Center"><PathIcon Data="{StaticResource IconGames}" /></Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="stat" FontSize="22" Text="{Binding Main.GamesStat}" />
              <TextBlock Classes="caption" Text="{Binding Main.GamesInstalledText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </views:Plate>
      </Grid>

      <Grid ColumnDefinitions="1.7*,22,*">
        <!-- Recent clips -->
        <views:Plate Classes="card" Padding="24,22">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="RECENT CLIPS" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="secondary" Padding="12,5" FontSize="13" Content="View all"
                      Command="{Binding Main.GoToCommand}" CommandParameter="{x:Static vm:Page.Clips}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Main.RecentClips}" IsVisible="{Binding Main.HasClips}" Margin="0,0,-16,-16">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipItemViewModel">
                  <views:ClipCard Margin="0,0,16,16" ThumbnailHeight="132" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="inset" Padding="24" IsVisible="{Binding Main.HasNoClips}">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="No clips yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="{Binding Main.SaveHint}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </views:Plate>

        <!-- Activity -->
        <views:Plate Grid.Column="2" Classes="card" Padding="24,22">
          <StackPanel Spacing="18">
            <!-- Recent events: everything, or just the notifications -->
            <Grid ColumnDefinitions="*,Auto" MinHeight="31">
              <TextBlock Classes="eyebrow" Text="ACTIVITY" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <RadioButton Classes="chip" GroupName="activityTab" Content="All" IsChecked="{Binding Main.ActivityShowsAll}" />
                <RadioButton Classes="chip" GroupName="activityTab" IsChecked="{Binding Main.ActivityShowsNotices}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Notifications" />
                    <TextBlock Text="{Binding Main.Notifications.UnreadText}" IsVisible="{Binding Main.Notifications.HasUnread}" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Grid>
            <Panel IsVisible="{Binding Main.ActivityShowsNotices}">
              <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Main.Notifications.HasNoHistory}"
                         Text="No notifications yet. Friend requests, clips you save, your subscription renewing and other news show up here." />
              <ScrollViewer MaxHeight="480" IsVisible="{Binding Main.Notifications.HasHistory}">
                <ItemsControl ItemsSource="{Binding Main.Notifications.History}" Margin="-8,-8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoticeItem">
                      <views:NoticeRow />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
            <ScrollViewer MaxHeight="480" IsVisible="{Binding Main.ActivityShowsAll}">
            <ItemsControl ItemsSource="{Binding Main.Activity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityItem">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,18">
                    <Panel VerticalAlignment="Top" Margin="0,0,14,0">
                      <Border Classes="tile small" IsVisible="{Binding IsClip}">
                        <PathIcon Data="{StaticResource IconBolt}" />
                      </Border>
                      <Border Classes="tile small record" IsVisible="{Binding IsRecording}">
                        <PathIcon Data="{StaticResource IconRecord}" Width="9" Height="9" />
                      </Border>
                      <Border Classes="tile small warn" IsVisible="{Binding IsProblem}">
                        <PathIcon Data="{StaticResource IconAlert}" />
                      </Border>
                      <Border Classes="tile small" IsVisible="{Binding IsMoment}">
                        <PathIcon Data="{StaticResource IconSparkle}" />
                      </Border>
                      <Border Classes="tile small neutral" IsVisible="{Binding IsInfo}">
                        <PathIcon Data="{StaticResource IconGames}" />
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Time}" Classes="caption" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </views:Plate>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
