<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             xmlns:views="using:ClipEngine.Desktop.Views"
             x:Class="ClipEngine.Desktop.Views.HomeView"
             x:DataType="vm:HomePage">
  <ScrollViewer>
    <StackPanel Margin="0,0,0,24" Spacing="14">

      <!-- What the engine is doing right now, and saving a clip -->
      <Border Classes="card" Padding="24,22">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="8" VerticalAlignment="Center">
            <Border Classes="pill" HorizontalAlignment="Left" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Classes="liveDot" Classes.pulsing="{Binding Main.IsRecording}" Fill="{Binding Main.StatusBrush}"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding Main.StatusEyebrow}" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                           Foreground="{StaticResource TextSecondary}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="display" Text="{Binding Main.StatusTitle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            <TextBlock Classes="body" Text="{Binding Main.StatusDetail}" TextWrapping="Wrap" MaxWidth="560"
                       HorizontalAlignment="Left" FontFeatures="tnum" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                        IsVisible="{Binding Main.HasEngineProblem}">
              <Button Classes="secondary" Content="Restart engine" Command="{Binding Main.RestartEngineCommand}" />
              <Button Classes="secondary" Content="Open log" Command="{Binding Main.OpenLogCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- Recording controls. Room for more next to Save clip, like starting a long recording. -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="24,0,0,0">
            <StackPanel Name="RecordingControls" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="accent" Command="{Binding Main.SaveClipCommand}" Height="48" Padding="22,0"
                      VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource IconBolt}" Width="16" Height="16" />
                  <TextBlock Text="Save clip" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding Main.SaveHint}" Classes="caption" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Numbers at a glance -->
      <UniformGrid Columns="4">
        <Border Classes="card" Padding="16" Margin="0,0,9,0">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tile" VerticalAlignment="Center"><PathIcon Data="{StaticResource IconClock}" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="stat" FontSize="20" Text="{Binding Main.BufferText}" />
              <TextBlock Classes="caption" Text="Replay buffer" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="card" Padding="16" Margin="3,0,6,0">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tile" VerticalAlignment="Center"><PathIcon Data="{StaticResource IconClips}" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="stat" FontSize="20" Text="{Binding Main.ClipsToday}" />
              <TextBlock Classes="caption" Text="Clips today" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="card" Padding="16" Margin="6,0,3,0">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tile" VerticalAlignment="Center"><PathIcon Data="{StaticResource IconDrive}" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="stat" FontSize="20" Text="{Binding Main.LibrarySize}" />
              <TextBlock Classes="caption" Text="Clip library" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="card" Padding="16" Margin="9,0,0,0">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tile" VerticalAlignment="Center"><PathIcon Data="{StaticResource IconGames}" /></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="stat" FontSize="20" Text="{Binding Main.GamesSupported}" />
              <TextBlock Classes="caption" Text="Games detected automatically" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </UniformGrid>

      <Grid ColumnDefinitions="1.7*,14,*">
        <!-- Recent clips -->
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="Recent clips" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="secondary" Padding="12,5" FontSize="13" Content="View all"
                      Command="{Binding Main.GoToCommand}" CommandParameter="{x:Static vm:Page.Clips}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Main.RecentClips}" IsVisible="{Binding Main.HasClips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipItemViewModel">
                  <views:ClipCard Margin="0,0,10,10" ThumbnailHeight="124" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="inset" Padding="24" IsVisible="{Binding Main.HasNoClips}">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="No clips yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="{Binding Main.SaveHint}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Activity -->
        <Border Grid.Column="2" Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <TextBlock Classes="h2" Text="Activity" />
            <ScrollViewer MaxHeight="440">
            <ItemsControl ItemsSource="{Binding Main.Activity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityItem">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                    <Panel VerticalAlignment="Top" Margin="0,0,12,0">
                      <Border Classes="tile small" IsVisible="{Binding IsClip}">
                        <PathIcon Data="{StaticResource IconBolt}" />
                      </Border>
                      <Border Classes="tile small record" IsVisible="{Binding IsRecording}">
                        <PathIcon Data="{StaticResource IconRecord}" Width="9" Height="9" />
                      </Border>
                      <Border Classes="tile small warn" IsVisible="{Binding IsProblem}">
                        <PathIcon Data="{StaticResource IconAlert}" />
                      </Border>
                      <Border Classes="tile small" IsVisible="{Binding IsMoment}">
                        <PathIcon Data="{StaticResource IconSparkle}" />
                      </Border>
                      <Border Classes="tile small neutral" IsVisible="{Binding IsInfo}">
                        <PathIcon Data="{StaticResource IconGames}" />
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Time}" Classes="caption" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
