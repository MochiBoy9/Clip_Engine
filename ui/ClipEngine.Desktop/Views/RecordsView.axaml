<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             xmlns:views="using:ClipEngine.Desktop.Views"
             x:Class="ClipEngine.Desktop.Views.RecordsView"
             x:DataType="vm:RecordsViewModel">
  <ScrollViewer>
    <StackPanel Margin="0,0,40,40" Spacing="22">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Records" />
        <TextBlock Classes="caption" Text="{Binding Summary}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- The match being played, against the player's best in that game -->
      <views:Plate Classes="card lead" Padding="32,28,30,28" IsVisible="{Binding HasLiveMatch}">
        <Panel>
          <views:Stripes Width="150" Height="9" Spacing="9" Fill="{DynamicResource AccentStripeBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-27,-29,0" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="8" VerticalAlignment="Center">
              <Border Classes="pill" HorizontalAlignment="Left" Padding="9,3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="liveDot pulsing" Fill="{StaticResource RecordBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding LiveTitle}" FontSize="11" FontWeight="Bold" LetterSpacing="1.1" />
                </StackPanel>
              </Border>
              <TextBlock Classes="h2" Text="{Binding LiveComparison}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="Counting from the game's own scoreboard" IsVisible="{Binding LiveFromScoreboard}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="32" Margin="24,0,0,0" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Classes="stat" Text="{Binding LiveKills}" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="Kills" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="stat" Text="{Binding LiveDeaths}" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="Deaths" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="stat" Text="{Binding LiveAssists}" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="Assists" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="stat" Text="{Binding LiveRevives}" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="Revives" HorizontalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Panel>
      </views:Plate>

      <views:Plate Classes="card" Padding="28" IsVisible="{Binding HasNoRecords}">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource IconTrophy}" Width="34" Height="34" Foreground="{StaticResource TextTertiary}" />
          <TextBlock Classes="h2" Text="No records yet" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                     Text="Every kill, assist, death and revive the engine sees is kept, clipped or not, and games' scoreboards fill in the exact numbers. Add your in-game name on the Games page so scoreboards can be read." />
        </StackPanel>
      </views:Plate>

      <!-- Lifetime totals -->
      <ItemsControl ItemsSource="{Binding Totals}" IsVisible="{Binding HasRecords}" Margin="0,0,-16,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TotalTile">
            <views:Plate Classes="card" Padding="20,18" Margin="0,0,16,0">
              <StackPanel Spacing="6">
                <Border Height="3" Width="22" Background="{Binding Brush}" HorizontalAlignment="Left" />
                <TextBlock Classes="stat" FontSize="22" Text="{Binding Value}" />
                <TextBlock Classes="caption" Text="{Binding Label}" />
              </StackPanel>
            </views:Plate>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Personal bests across every game -->
      <StackPanel Spacing="14" IsVisible="{Binding HasRecords}">
        <TextBlock Classes="eyebrow" Text="PERSONAL BESTS" />
        <ItemsControl ItemsSource="{Binding Records}" Margin="0,0,-18,-18">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecordCard">
              <views:Plate Classes="card" Padding="0" Margin="0,0,18,18">
                <Grid ColumnDefinitions="Auto,*">
                  <!-- The game's colour, as a bar down the card's edge -->
                  <Border Width="4" Background="{Binding Gradient}" />
                  <StackPanel Grid.Column="1" Margin="22,20" Spacing="5">
                    <TextBlock Classes="eyebrow" Text="{Binding Title}" />
                    <TextBlock Classes="stat" Text="{Binding Value}" FontSize="34" />
                    <TextBlock Classes="body" Text="{Binding ValueText}" />
                    <TextBlock Classes="caption" Text="{Binding Detail}" />
                  </StackPanel>
                </Grid>
              </views:Plate>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid ColumnDefinitions="*,22,*" IsVisible="{Binding HasRecords}">
        <!-- Totals per game -->
        <views:Plate Classes="card" Padding="24,22">
          <StackPanel Spacing="18">
            <TextBlock Classes="eyebrow" Text="BY GAME" />
            <ItemsControl ItemsSource="{Binding GameTotals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameTotalsRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                    <Border Width="38" Height="38" CornerRadius="2" Background="{Binding Gradient}" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Initials}" FontWeight="Black" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                      <StackPanel>
                        <TextBlock Text="{Binding Kills}" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Classes="caption" Text="kills" HorizontalAlignment="Right" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding KillDeath}" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Classes="caption" Text="K/D" HorizontalAlignment="Right" />
                      </StackPanel>
                      <StackPanel MinWidth="64">
                        <TextBlock Text="{Binding Best}" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Classes="caption" Text="best match" HorizontalAlignment="Right" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </views:Plate>

        <!-- Recent matches -->
        <views:Plate Grid.Column="2" Classes="card" Padding="24,22">
          <StackPanel Spacing="18">
            <TextBlock Classes="eyebrow" Text="RECENT MATCHES" />
            <ItemsControl ItemsSource="{Binding RecentMatches}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MatchRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16" ToolTip.Tip="{Binding Source}">
                    <Border Width="38" Height="38" CornerRadius="2" Background="{Binding Gradient}" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Initials}" FontWeight="Black" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Game}" FontWeight="SemiBold" />
                        <Border Classes="pill accent" Padding="7,1" IsVisible="{Binding IsRecord}">
                          <TextBlock Text="RECORD" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" />
                        </Border>
                      </StackPanel>
                      <TextBlock Classes="caption" Text="{Binding When}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Line}" FontWeight="Bold" HorizontalAlignment="Right" />
                      <TextBlock Classes="caption" Text="{Binding Result}" IsVisible="{Binding HasResult}" HorizontalAlignment="Right"
                                 Classes.win="{Binding IsWin}" Classes.loss="{Binding IsLoss}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </views:Plate>
      </Grid>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="TextBlock.caption.win">
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.caption.loss">
      <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
