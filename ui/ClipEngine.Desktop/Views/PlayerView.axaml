<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             xmlns:views="using:ClipEngine.Desktop.Views"
             x:Class="ClipEngine.Desktop.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Focusable="True">
  <DockPanel Margin="0,0,40,32">
    <!-- Title and what you can do with the clip -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,22">
      <Button Classes="secondary" Command="{Binding BackCommand}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource IconBack}" Width="14" Height="14" />
          <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="h1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <Border Classes="pill accent" VerticalAlignment="Center" Padding="8,2"
                  IsVisible="{Binding Clip.IsAutomatic}" ToolTip.Tip="Saved by itself when moments were detected">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconSparkle}" Width="10" Height="10" />
              <TextBlock Text="AUTO" FontSize="10" FontWeight="Bold" LetterSpacing="1" />
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="accent" Command="{Binding ShareCommand}" IsEnabled="{Binding !Main.IsSharing}"
                ToolTip.Tip="{Binding ShareTip}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconShare}" Width="14" Height="14" />
            <TextBlock Text="Share to Discord" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="secondary" Command="{Binding TrimCommand}" Classes.active="{Binding IsTrimming}"
                ToolTip.Tip="Keep just part of the clip, saved as a new clip (I and O set the start and end)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconTrim}" Width="14" Height="14" />
            <TextBlock Text="Trim" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="secondary" Command="{Binding CheckCommand}" Classes.active="{Binding IsChecking}"
                ToolTip.Tip="Mark what really happened in this clip and see what detection catches, misses and gets wrong">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconScan}" Width="14" Height="14" />
            <TextBlock Text="Check detection" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="secondary" Command="{Binding CopyCommand}" ToolTip.Tip="Copy the full-quality clip to paste anywhere">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
            <TextBlock Text="Copy" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="icon" Command="{Binding FavoriteCommand}" ToolTip.Tip="{Binding Clip.FavoriteTip}">
          <Panel>
            <PathIcon Data="{StaticResource IconStarOutline}" IsVisible="{Binding !Clip.IsFavorite}" />
            <PathIcon Data="{StaticResource IconStar}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding Clip.IsFavorite}" />
          </Panel>
        </Button>
        <Button Classes="icon" Command="{Binding StudioCommand}"
                ToolTip.Tip="Teach Clip Engine to spot a moment from this frame (Detection Studio)">
          <PathIcon Data="{StaticResource IconScan}" />
        </Button>
        <Button Classes="icon" Command="{Binding ShowCommand}" ToolTip.Tip="Show in folder">
          <PathIcon Data="{StaticResource IconFolder}" />
        </Button>
        <Button Classes="icon" Command="{Binding OpenExternallyCommand}" ToolTip.Tip="Open in your default video player">
          <PathIcon Data="{StaticResource IconExternal}" />
        </Button>
        <Button Classes="icon danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
          <PathIcon Data="{StaticResource IconTrash}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Detected moments -->
    <views:Plate DockPanel.Dock="Right" Classes="card" Width="320" Margin="20,0,0,0" Padding="22,22,12,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,10,14">
          <TextBlock Classes="h2" Text="Moments" />
          <ItemsControl ItemsSource="{Binding Counts}" IsVisible="{Binding HasMarkers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MarkerCount">
                <Border Classes="pill" Margin="0,0,6,6" Padding="9,2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Panel>
          <ScrollViewer IsVisible="{Binding HasMarkers}">
            <ItemsControl ItemsSource="{Binding Markers}" Margin="0,0,8,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MarkerViewModel">
                  <StackPanel>
                    <Button Classes="marker" Classes.active="{Binding IsSelected}" Command="{Binding SeekCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            ToolTip.Tip="Jump to it and see how it was found">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Border Width="3" Height="26" CornerRadius="0" Background="{Binding Brush}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
                          <TextBlock Text="{Binding Text}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <PathIcon Grid.Column="2" Data="{StaticResource IconCheck}" Width="11" Height="11" Margin="8,0,0,0"
                                  Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                  IsVisible="{Binding IsConfirmed}" ToolTip.Tip="{Binding ConfirmedTip}" />
                        <TextBlock Grid.Column="3" Text="{Binding TimeText}" Classes="caption" VerticalAlignment="Center"
                                   FontFeatures="tnum" Margin="8,0,0,0" />
                      </Grid>
                    </Button>
                    <!-- How it was found: every rule that saw it, what each read, and which one counted it -->
                    <Border IsVisible="{Binding IsSelected}" Classes="inset" Padding="10,8" Margin="15,2,0,8">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="caption" Text="{Binding WhySummary}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Witnesses}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WitnessViewModel">
                              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,5,8,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                  <TextBlock FontSize="12">
                                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Detail}" Foreground="{StaticResource TextTertiary}" />
                                  </TextBlock>
                                  <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                             ToolTip.Tip="What this rule read off the screen" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="secondary" Command="{Binding StudioCommand}" IsVisible="{Binding HasWitnesses}"
                                HorizontalAlignment="Left" Padding="8,3"
                                ToolTip.Tip="Open this frame in Detection Studio with the rule that counted it, to see its box and fix it">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconScan}" Width="11" Height="11" />
                            <TextBlock Text="See it in Studio" FontSize="12" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel IsVisible="{Binding HasNoMarkers}" Spacing="6" Margin="0,4,8,0">
            <TextBlock Classes="body" TextWrapping="Wrap"
                       Text="No moments were detected in this clip." />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Kills, assists, revives and other moments the engine reads off the screen show up here, so you can jump straight to them." />
          </StackPanel>
        </Panel>
      </DockPanel>
    </views:Plate>

    <!-- The video and its controls -->
    <views:Plate Classes="card" Padding="10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="6,12,6,0" Spacing="6">
          <!-- Trimming: what's kept, and saving it as a new clip -->
          <Border IsVisible="{Binding IsTrimming}" Classes="inset" Padding="10,8" Margin="0,0,0,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="secondary" Command="{Binding SetTrimStartCommand}" ToolTip.Tip="Start the trimmed clip at the playhead (I)">
                  <TextBlock Text="Set start · I" />
                </Button>
                <Button Classes="secondary" Command="{Binding SetTrimEndCommand}" ToolTip.Tip="End the trimmed clip at the playhead (O)">
                  <TextBlock Text="Set end · O" />
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconTrim}" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding TrimText}" FontFeatures="tnum" FontWeight="SemiBold" FontSize="13" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelTrimCommand}" />
                <Button Classes="accent" Command="{Binding SaveTrimCommand}"
                        ToolTip.Tip="Saves this part as a new clip next to the original, at full quality">
                  <Panel>
                    <TextBlock Text="Save trimmed clip" IsVisible="{Binding !IsSavingTrim}" />
                    <TextBlock Text="Saving…" IsVisible="{Binding IsSavingTrim}" />
                  </Panel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <!-- Checking detection: marking what really happened, then scoring the rules on it -->
          <Border IsVisible="{Binding IsChecking}" Classes="inset" Padding="12,10" Margin="0,0,0,4">
            <StackPanel DataContext="{Binding Accuracy}" x:DataType="vm:AccuracyViewModel" Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ComboBox Width="140" ItemsSource="{Binding Events}" SelectedItem="{Binding MarkType}"
                            ToolTip.Tip="What the next mark is (1 to 7)" />
                  <Button Classes="accent" Command="{Binding MarkCommand}" ToolTip.Tip="Mark this moment at the playhead (M)">
                    <TextBlock Text="Mark · M" />
                  </Button>
                  <Button Classes="secondary" Command="{Binding StartFromDetectedCommand}"
                          ToolTip.Tip="Start from the moments detection saved with the clip, then remove the wrong ones and mark the missed">
                    <TextBlock Text="Start from detected" />
                  </Button>
                  <Button Classes="secondary" Command="{Binding ClearCommand}" Content="Clear" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding MarksCaption}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="14,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ProgressBar Width="90" Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsScanning}"
                               VerticalAlignment="Center" />
                  <Button Classes="secondary" Content="Stop" Command="{Binding CancelCommand}" IsVisible="{Binding IsScanning}" />
                  <Button Classes="secondary" Command="{Binding TeachCommand}"
                          ToolTip.Tip="Teach the universal HUD reader from your marks: what it missed and what it counted that wasn't there. Mark every moment in the clip first">
                    <TextBlock Text="Teach" />
                  </Button>
                  <Button Classes="accent" Command="{Binding RunCommand}"
                          ToolTip.Tip="Run this game's rules over the whole clip the way the engine reads the game, and compare with your marks">
                    <TextBlock Text="Run detection" />
                  </Button>
                </StackPanel>
              </Grid>

              <ScrollViewer MaxHeight="64" IsVisible="{Binding HasMarks}" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Marks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MarkViewModel">
                      <Button Classes="secondary" Command="{Binding SeekCommand}" Margin="0,0,6,6" Padding="8,3,4,3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                          <TextBlock FontSize="12" FontFeatures="tnum" VerticalAlignment="Center">
                            <Run Text="{Binding Label}" />
                            <Run Text="{Binding TimeText}" Foreground="{StaticResource TextTertiary}" />
                          </TextBlock>
                          <Button Classes="icon" Command="{Binding RemoveCommand}" Width="20" Height="20" Padding="4"
                                  ToolTip.Tip="Take this mark off">
                            <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
                          </Button>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel Spacing="6" IsVisible="{Binding HasStatus}">
                <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap"
                           Foreground="{StaticResource WarnBrush}" IsVisible="{Binding StatusIsError}" />
                <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding !StatusIsError}" />
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding HasResult}">
                <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" FontSize="13" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccuracyRow">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                        <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock FontSize="12" FontFeatures="tnum">
                          <Run Text="{Binding Label}" FontWeight="SemiBold" />
                          <Run Text="{Binding Text}" Foreground="{StaticResource TextSecondary}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasMissed}">
                  <TextBlock Classes="caption" Text="Missed:" VerticalAlignment="Center" />
                  <ItemsControl ItemsSource="{Binding Missed}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MarkerViewModel">
                        <Button Classes="secondary" Command="{Binding SeekCommand}" Margin="0,0,6,0" Padding="6,2"
                                ToolTip.Tip="Jump there, then open Detection Studio to fix the rule">
                          <TextBlock FontSize="12" FontFeatures="tnum">
                            <Run Text="{Binding Label}" />
                            <Run Text="{Binding TimeText}" Foreground="{StaticResource TextTertiary}" />
                          </TextBlock>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasExtra}">
                  <TextBlock Classes="caption" Text="Not really there:" VerticalAlignment="Center" />
                  <ItemsControl ItemsSource="{Binding Extra}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MarkerViewModel">
                        <Button Classes="secondary" Command="{Binding SeekCommand}" Margin="0,0,6,0" Padding="6,2"
                                ToolTip.Tip="{Binding Text}">
                          <TextBlock FontSize="12" FontFeatures="tnum">
                            <Run Text="{Binding Label}" />
                            <Run Text="{Binding TimeText}" Foreground="{StaticResource TextTertiary}" />
                          </TextBlock>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <views:MarkerTimeline Position="{Binding Position}" Duration="{Binding Duration}" Markers="{Binding Markers}"
                                IsTrimming="{Binding IsTrimming}" TrimStart="{Binding TrimStart}" TrimEnd="{Binding TrimEnd}" />
          <Grid ColumnDefinitions="*,Auto,*">
            <TextBlock VerticalAlignment="Center" FontFeatures="tnum" FontSize="13">
              <Run Text="{Binding PositionText}" FontWeight="SemiBold" />
              <Run Text=" / " Foreground="{StaticResource TextTertiary}" />
              <Run Text="{Binding DurationText}" Foreground="{StaticResource TextTertiary}" />
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="icon" Command="{Binding PreviousMarkerCommand}" ToolTip.Tip="Previous moment">
                <PathIcon Data="{StaticResource IconPrevMarker}" />
              </Button>
              <Button Classes="icon" Command="{Binding SkipBackCommand}" ToolTip.Tip="Back 5 seconds (Left)">
                <PathIcon Data="{StaticResource IconSkipBack}" />
              </Button>
              <Button Classes="accent" Width="48" Height="48" CornerRadius="24" Padding="0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play or pause (Space)">
                <Panel>
                  <PathIcon Data="{StaticResource IconPlay}" Width="18" Height="18" Margin="3,0,0,0"
                            IsVisible="{Binding IsPaused}" />
                  <PathIcon Data="{StaticResource IconPause}" Width="18" Height="18"
                            IsVisible="{Binding IsPlaying}" />
                </Panel>
              </Button>
              <Button Classes="icon" Command="{Binding SkipForwardCommand}" ToolTip.Tip="Forward 5 seconds (Right)">
                <PathIcon Data="{StaticResource IconSkipForward}" />
              </Button>
              <Button Classes="icon" Command="{Binding NextMarkerCommand}" ToolTip.Tip="Next moment">
                <PathIcon Data="{StaticResource IconNextMarker}" />
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <PathIcon Data="{StaticResource IconVolume}" Width="16" Height="16" Foreground="{StaticResource TextSecondary}"
                        VerticalAlignment="Center" />
              <Slider Width="110" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <Border Background="Black" CornerRadius="0" ClipToBounds="True">
          <Panel Name="VideoHost">
            <!-- The preview tool has no video window, so it shows the clip's thumbnail. -->
            <Image Source="{Binding Clip.Thumbnail}" Stretch="Uniform" IsVisible="{Binding !IsLive}" />
            <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="420">
              <Border Classes="tile record" Width="44" Height="44" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconAlert}" Width="20" Height="20" />
              </Border>
              <TextBlock Classes="body" Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Panel>
        </Border>
      </DockPanel>
    </views:Plate>
  </DockPanel>
</UserControl>
