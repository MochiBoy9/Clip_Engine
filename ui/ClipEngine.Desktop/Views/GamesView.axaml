<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             x:Class="ClipEngine.Desktop.Views.GamesView"
             x:DataType="vm:GamesPage">
  <ScrollViewer>
    <StackPanel Margin="18,0,22,24" Spacing="18">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Games" />
        <TextBlock Classes="caption" Text="Clip Engine starts recording as soon as one of these opens, on the monitor it's on." />
      </StackPanel>

      <!-- Killfeed games need the player's name to tell their kills from everyone else's. -->
      <Border x:Name="NameCard" x:DataType="vm:PlayerNamesViewModel" Classes="glass" Padding="24" Margin="0,0,16,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource AccentGradient}"
                  BoxShadow="{StaticResource AccentGlow}" VerticalAlignment="Top" Margin="0,0,18,0">
            <PathIcon Data="{StaticResource IconSparkle}" Width="22" Height="22" Foreground="White" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="h2" Text="Your in-game name" />
            <TextBlock Classes="body" TextWrapping="Wrap"
                       Text="Valorant, Marvel Rivals, Rainbow Six Siege and Delta Force show kills in a killfeed, so Clip Engine looks for your name there. Separate names for different games with commas, without the #tag." />
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBox Text="{Binding Names}" Watermark="Your name, as it shows in the killfeed" />
              <Button Grid.Column="1" Classes="accent" Content="Save" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Main.Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameItemViewModel">
            <Border Classes="glass" Padding="0" Margin="0,0,16,16" CornerRadius="26">
              <Panel>
                <!-- Tinted wash of the game's colours across the top of the card -->
                <Border Background="{Binding Gradient}" Opacity="0.4" IsHitTestVisible="False">
                  <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#FF000000" />
                      <GradientStop Offset="0.75" Color="#00000000" />
                    </LinearGradientBrush>
                  </Border.OpacityMask>
                </Border>
                <StackPanel Margin="22" Spacing="16">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{Binding Gradient}"
                            BorderBrush="#66FFFFFF" BorderThickness="1"
                            BoxShadow="0 10 26 0 #55000010, inset 0 1 0 0 #80FFFFFF">
                      <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Black" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Classes="pill" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="#33FF4D7A" BorderBrush="#80FF4D7A" IsVisible="{Binding IsRecording}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="liveDot pulsing" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock Text="REC" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="{Binding Name}" FontSize="19" />
                    <TextBlock Classes="body" Text="{Binding Status}" FontSize="13" />
                  </StackPanel>
                  <Border Height="1" Background="{StaticResource Divider}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="caption" Text="{Binding ClipCountText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DetectionText}" VerticalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}" />
                  </Grid>
                </StackPanel>
              </Panel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="glass" Padding="24" Margin="0,0,16,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource AccentGradient}"
                  BoxShadow="{StaticResource AccentGlow}" VerticalAlignment="Top" Margin="0,0,18,0">
            <PathIcon Data="{StaticResource IconScan}" Width="22" Height="22" Foreground="White" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,18,0">
            <TextBlock Classes="h2" Text="Detection Studio" />
            <TextBlock Classes="body" TextWrapping="Wrap"
                       Text="Add any game, or fix how one is read. Pick a frame from a clip, draw a box over the kill feed, type the words it shows, and test it before saving." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="glass" Command="{Binding Main.OpenStudioCommand}" CommandParameter="add"
                    ToolTip.Tip="Record and detect moments in a game Clip Engine doesn't know yet">
              <TextBlock Text="Add a game" />
            </Button>
            <Button Classes="accent" Command="{Binding Main.OpenStudioCommand}">
              <TextBlock Text="Open Studio" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
