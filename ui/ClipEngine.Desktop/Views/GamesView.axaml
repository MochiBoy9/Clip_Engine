<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ClipEngine.Desktop.Views"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             x:Class="ClipEngine.Desktop.Views.GamesView"
             x:DataType="vm:GamesPage">
  <ScrollViewer>
    <StackPanel Margin="0,0,0,24" Spacing="14">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Games" />
        <TextBlock Classes="caption" Text="Clip Engine starts recording as soon as one of these opens, on the monitor it's on." />
      </StackPanel>

      <!-- Killfeed games need the player's name to tell their kills from everyone else's. -->
      <views:Plate x:Name="NameCard" x:DataType="vm:PlayerNamesViewModel" Classes="card" Padding="20" Margin="0,0,12,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Classes="tile" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,16,0">
            <PathIcon Data="{StaticResource IconSparkle}" Width="18" Height="18" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="h2" Text="Your in-game name" />
            <TextBlock Classes="body" TextWrapping="Wrap"
                       Text="Valorant, Marvel Rivals, Rainbow Six Siege, Delta Force, Deadlock, Halo Infinite, Destiny 2 and Team Fortress 2 show kills in a killfeed, so Clip Engine looks for your name there. Separate names for different games with commas, without the #tag." />
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBox Text="{Binding Names}" Watermark="Your name, as it shows in the killfeed" />
              <Button Grid.Column="1" Classes="accent" Content="Save" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </views:Plate>

      <ItemsControl ItemsSource="{Binding Main.Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameItemViewModel">
            <views:Plate Classes="card" Padding="18" Margin="0,0,12,12">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="48" Height="48" CornerRadius="2" Background="{Binding Gradient}">
                    <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="Black" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="h2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding Status}" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="pill record" Padding="8,2" VerticalAlignment="Top"
                          IsVisible="{Binding IsRecording}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Classes="liveDot pulsing" Width="6" Height="6" VerticalAlignment="Center" />
                      <TextBlock Text="REC" FontSize="10" FontWeight="Bold" LetterSpacing="1" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Height="1" Background="{StaticResource Divider}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caption" Text="{Binding ClipCountText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DetectionText}" VerticalAlignment="Center"
                             Foreground="{StaticResource TextSecondary}" />
                </Grid>
              </StackPanel>
            </views:Plate>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <views:Plate Classes="card" Padding="20" Margin="0,0,12,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="tile" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,16,0">
            <PathIcon Data="{StaticResource IconScan}" Width="18" Height="18" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,18,0">
            <TextBlock Classes="h2" Text="Detection Studio" />
            <TextBlock Classes="body" TextWrapping="Wrap"
                       Text="Add any game, or fix how one is read. Pick a frame from a clip, draw a box over the kill feed, type the words it shows, and test it before saving." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="secondary" Command="{Binding Main.OpenStudioCommand}" CommandParameter="add"
                    ToolTip.Tip="Record and detect moments in a game Clip Engine doesn't know yet">
              <TextBlock Text="Add a game" />
            </Button>
            <Button Classes="accent" Command="{Binding Main.OpenStudioCommand}">
              <TextBlock Text="Open Studio" />
            </Button>
          </StackPanel>
        </Grid>
      </views:Plate>
    </StackPanel>
  </ScrollViewer>
</UserControl>
