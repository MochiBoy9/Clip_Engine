<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipEngine.Desktop.Views.GameNoticeWindow"
        Title="Clip Engine notice"
        Width="420"
        SizeToContent="Height"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent, None">
  <!-- A small notice in the corner over the game, like "Clip saved · 2 kills". Left out of recordings. -->
  <Border Margin="10" HorizontalAlignment="Right" CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource GlassStroke}" Padding="14,10"
          BoxShadow="0 10 28 0 #66000010, inset 0 1 0 0 #40FFFFFF" Background="#F21B1836" IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource AccentGradient}">
        <PathIcon Data="{StaticResource IconCheck}" Width="13" Height="13" Foreground="White" />
      </Border>
      <TextBlock Name="Message" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="White"
                 MaxWidth="360" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Border>
</Window>
