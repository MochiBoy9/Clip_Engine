<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ClipEngine.Desktop.Views"
        x:Class="ClipEngine.Desktop.Views.GameNoticeWindow"
        Title="Clip Engine notice"
        Width="420"
        SizeToContent="Height"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent, None">
  <!-- A small notice in the corner over the game, like "Clip saved · 2 kills". Left out of recordings. -->
  <views:Plate Margin="10" HorizontalAlignment="Right" Cut="8" BorderBrush="{DynamicResource AccentBrush}"
               Padding="12,9,16,9" Background="{StaticResource OverlayBrush}" IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Border Classes="tile small">
        <PathIcon Data="{StaticResource IconCheck}" />
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="1">
        <TextBlock Name="Message" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                   MaxWidth="360" TextTrimming="CharacterEllipsis" />
        <TextBlock Name="Detail" FontSize="12" Foreground="{StaticResource TextSecondary}" MaxWidth="360" TextWrapping="Wrap"
                   MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="False" />
      </StackPanel>
    </StackPanel>
  </views:Plate>
</Window>
