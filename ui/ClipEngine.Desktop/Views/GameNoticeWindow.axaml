<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipEngine.Desktop.Views.GameNoticeWindow"
        Title="Clip Engine notice"
        Width="420"
        SizeToContent="Height"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent, None">
  <!-- A small notice in the corner over the game, like "Clip saved · 2 kills". Left out of recordings. -->
  <Border Margin="10" HorizontalAlignment="Right" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderStrongBrush}"
          Padding="12,9" BoxShadow="{StaticResource FloatShadow}" Background="{StaticResource OverlayBrush}" IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Border Classes="tile small">
        <PathIcon Data="{StaticResource IconCheck}" />
      </Border>
      <TextBlock Name="Message" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                 MaxWidth="360" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Border>
</Window>
