<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             xmlns:views="using:ClipEngine.Desktop.Views"
             x:Class="ClipEngine.Desktop.Views.ClipCard"
             x:DataType="vm:ClipItemViewModel">
  <views:Plate Classes="clipCard" Padding="6" VerticalAlignment="Top">
    <StackPanel Spacing="9">
      <Border Name="Thumb" CornerRadius="0" ClipToBounds="True" Height="{Binding $parent[views:ClipCard].ThumbnailHeight}"
              Background="{Binding Placeholder}">
        <Panel>
          <!-- Without a thumbnail yet, show the game's initials on its gradient -->
          <TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasThumbnail}" FontSize="40" FontWeight="Black"
                     Foreground="#59FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" LetterSpacing="-1" />
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />

          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
            <Border Classes="pill onMedia" Padding="8,2">
              <TextBlock Text="{Binding Game}" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border Classes="pill accent" Padding="7,2"
                    IsVisible="{Binding IsAutomatic}" ToolTip.Tip="Saved by itself when moments were detected">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconSparkle}" Width="9" Height="9" />
                <TextBlock Text="AUTO" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Classes="pill onMedia" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="8" Padding="7,2" IsVisible="{Binding HasDuration}">
            <TextBlock Text="{Binding Duration}" FontSize="11" FontWeight="SemiBold" FontFeatures="tnum" />
          </Border>
          <Border Classes="pill onMedia" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" Margin="8" Padding="6,3" IsVisible="{Binding IsFavorite}"
                  ToolTip.Tip="Favorite: never cleaned up">
            <PathIcon Data="{StaticResource IconStar}" Width="11" Height="11" Foreground="{DynamicResource AccentBrush}" />
          </Border>

          <Panel Classes="hoverActions">
            <Button Classes="accent" Width="46" Height="46" CornerRadius="23" Padding="0" HorizontalAlignment="Center"
                    VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding OpenCommand}" ToolTip.Tip="Play">
              <PathIcon Data="{StaticResource IconPlay}" Width="18" Height="18" Margin="3,0,0,0" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="8">
              <Button Classes="icon onMedia" Width="28" Height="28" CornerRadius="7" Command="{Binding FavoriteCommand}"
                      ToolTip.Tip="{Binding FavoriteTip}">
                <Panel>
                  <PathIcon Data="{StaticResource IconStarOutline}" Width="13" Height="13" IsVisible="{Binding !IsFavorite}" />
                  <PathIcon Data="{StaticResource IconStar}" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}"
                            IsVisible="{Binding IsFavorite}" />
                </Panel>
              </Button>
              <Button Classes="icon onMedia" Width="28" Height="28" CornerRadius="7" Command="{Binding ShareCommand}"
                      ToolTip.Tip="Share to Discord">
                <PathIcon Data="{StaticResource IconShare}" Width="13" Height="13" />
              </Button>
              <Button Classes="icon onMedia" Width="28" Height="28" CornerRadius="7" Command="{Binding ShowCommand}"
                      ToolTip.Tip="Show in folder">
                <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
              </Button>
              <Button Classes="icon onMedia danger" Width="28" Height="28" CornerRadius="7" Command="{Binding DeleteCommand}"
                      ToolTip.Tip="Delete">
                <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
              </Button>
            </StackPanel>
          </Panel>
        </Panel>
      </Border>
      <!-- The clip's moments along its length -->
      <views:EventRibbon Ticks="{Binding Ribbon}" Height="8" Margin="4,0" IsVisible="{Binding HasRibbon}" />
      <StackPanel Margin="4,0,4,5" Spacing="1">
        <TextBlock Text="{Binding When}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Title}" />
        <TextBlock Text="{Binding Caption}" Classes="caption" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </StackPanel>
  </views:Plate>
</UserControl>
