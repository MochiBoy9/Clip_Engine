<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClipEngine.Desktop.ViewModels"
             xmlns:views="using:ClipEngine.Desktop.Views"
             x:Class="ClipEngine.Desktop.Views.ClipCard"
             x:DataType="vm:ClipItemViewModel">
  <Border Classes="glass soft clipCard" Padding="8" CornerRadius="22" VerticalAlignment="Top">
    <StackPanel Spacing="10">
      <Border Name="Thumb" CornerRadius="15" ClipToBounds="True" Height="{Binding $parent[views:ClipCard].ThumbnailHeight}"
              Background="{Binding Placeholder}">
        <Panel>
          <!-- Without a thumbnail yet, show the game's initials on its gradient -->
          <TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasThumbnail}" FontSize="40" FontWeight="Black"
                     Foreground="#59FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" LetterSpacing="-1" />
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />

          <!-- Sheen along the top edge, like the other glass -->
          <Border IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#33FFFFFF" />
                <GradientStop Offset="0.35" Color="#00FFFFFF" />
                <GradientStop Offset="0.65" Color="#00000000" />
                <GradientStop Offset="1" Color="#73000000" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <Border Classes="pill" Background="#59000000" BorderBrush="#33FFFFFF" HorizontalAlignment="Left"
                  VerticalAlignment="Top" Margin="8" Padding="9,3">
            <TextBlock Text="{Binding Game}" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Border Classes="pill" Background="#73000000" BorderBrush="#33FFFFFF" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="8" Padding="8,2" IsVisible="{Binding HasDuration}">
            <TextBlock Text="{Binding Duration}" FontSize="11" FontWeight="SemiBold" />
          </Border>

          <Panel Classes="hoverActions">
            <Button Classes="icon" Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="#40FFFFFF" BorderBrush="#80FFFFFF"
                    Command="{Binding OpenCommand}" ToolTip.Tip="Play">
              <PathIcon Data="{StaticResource IconPlay}" Width="20" Height="20" Margin="3,0,0,0" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="8">
              <Button Classes="icon" Width="30" Height="30" CornerRadius="10" Command="{Binding ShowCommand}"
                      ToolTip.Tip="Show in folder">
                <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
              </Button>
              <Button Classes="icon danger" Width="30" Height="30" CornerRadius="10" Command="{Binding DeleteCommand}"
                      ToolTip.Tip="Delete">
                <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Panel>
        </Panel>
      </Border>
      <StackPanel Margin="6,0,6,6" Spacing="2">
        <TextBlock Text="{Binding When}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Title}" />
        <TextBlock Text="{Binding Size}" Classes="caption" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
