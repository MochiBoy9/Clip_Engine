<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClipEngine.Desktop.ViewModels"
        xmlns:views="using:ClipEngine.Desktop.Views"
        x:Class="ClipEngine.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Clip Engine"
        Icon="avares://ClipEngine/Assets/ClipEngine.ico"
        Width="1280" Height="820" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomePage"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:ClipsPage"><views:ClipsView /></DataTemplate>
    <DataTemplate DataType="vm:GamesPage"><views:GamesView /></DataTemplate>
    <DataTemplate DataType="vm:RecordsViewModel"><views:RecordsView /></DataTemplate>
    <DataTemplate DataType="vm:JournalViewModel"><views:JournalView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:PlayerViewModel"><views:PlayerView /></DataTemplate>
    <DataTemplate DataType="vm:EditorViewModel"><views:EditorView /></DataTemplate>
    <DataTemplate DataType="vm:StudioViewModel"><views:StudioView /></DataTemplate>
    <DataTemplate DataType="vm:SquadViewModel"><views:SquadView /></DataTemplate>
    <DataTemplate DataType="vm:SquadPlayerViewModel"><views:SquadPlayerView /></DataTemplate>
    <DataTemplate DataType="vm:CloudViewModel"><views:CloudView /></DataTemplate>
    <DataTemplate DataType="vm:FriendsViewModel"><views:FriendsView /></DataTemplate>
  </Window.DataTemplates>

  <Panel Name="Root">
    <Grid ColumnDefinitions="76,*">
      <!-- The navigation rail -->
      <Border Background="{StaticResource RailBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,14,0,28" HorizontalAlignment="Center" IsHitTestVisible="False">
            <views:Plate Width="40" Height="40" Cut="9" Background="{DynamicResource AccentBrush}">
              <PathIcon Data="{StaticResource IconPlay}" Width="20" Height="20" Margin="2,0,0,0"
                        Foreground="{DynamicResource AccentForegroundBrush}" />
            </views:Plate>
            <views:Stripes Width="40" Height="5" Spacing="6" Fill="{DynamicResource AccentBrush}" Opacity="0.55" />
          </StackPanel>

          <!-- Engine status and the side panel, always in reach -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,0,0,14" HorizontalAlignment="Center">
            <!-- Notifications: the bell opens their history, with a count of the new ones -->
            <Panel Width="40" Height="40" HorizontalAlignment="Center">
              <Button Name="Bell" Classes="icon" Width="40" Height="40" Command="{Binding Notifications.TogglePanelCommand}"
                      ToolTip.Tip="{Binding Notifications.BellTip}">
                <PathIcon Data="{StaticResource IconBell}" />
              </Button>
              <Border Classes="pill accent" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0" Padding="4,0"
                      MinWidth="17" IsHitTestVisible="False" IsVisible="{Binding Notifications.HasUnread}">
                <TextBlock Text="{Binding Notifications.UnreadText}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
              </Border>
            </Panel>
            <Button Classes="icon" Width="40" Height="40" HorizontalAlignment="Center" Command="{Binding ToggleSidePanelCommand}"
                    ToolTip.Tip="{Binding SidePanelHotkey, StringFormat='Side panel over your game ({0})'}">
              <PathIcon Data="{StaticResource IconPanel}" />
            </Button>
            <StackPanel Spacing="5" HorizontalAlignment="Center" ToolTip.Tip="{Binding SaveHint}" Background="Transparent">
              <Panel Width="8" Height="8" HorizontalAlignment="Center">
                <Ellipse Fill="{Binding StatusBrush}" Classes="liveDot" Classes.pulsing="{Binding IsRecording}" />
              </Panel>
              <TextBlock Text="{Binding SidebarStatus}" FontFamily="{StaticResource DisplayFont}" FontSize="10"
                         FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                         MaxWidth="64" />
            </StackPanel>
          </StackPanel>

          <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Grid ColumnDefinitions="3,*" Height="62">
                  <Border Classes="navBar" />
                  <TextBlock Grid.Column="1" Classes="navIndex" Text="{Binding Index}" Margin="6,5,0,0"
                             HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="0,0,3,0">
                    <PathIcon Classes="navIcon" Data="{Binding Icon}" Width="21" Height="21" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="11"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{Binding $parent[ListBoxItem].Foreground}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="40,*">
        <!-- Graph paper behind the pages -->
        <views:DotGrid Grid.Row="1" IsHitTestVisible="False" />
        <!-- Ultra's adaptive themes: a wash of colour and, now and then, a scan down the page -->
        <views:AdaptiveBackdrop Name="Backdrop" Grid.Row="1" />
        <!-- The title bar: where you are and what the engine is doing. Not clickable, so it drags the window. -->
        <Grid ColumnDefinitions="*,Auto" Margin="40,0,150,0" IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="CLIP ENGINE" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold"
                       LetterSpacing="1.8" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="//" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextTertiary}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedNav.Index}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                       FontWeight="Bold" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedNav.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                       FontWeight="SemiBold" LetterSpacing="1.2" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" />
            <views:Barcode Seed="{Binding Version}" Fill="{StaticResource BorderStrongBrush}" Width="44" Height="12"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBlock Text="{Binding Version}" Classes="mono caption" FontSize="11" VerticalAlignment="Center" />
            <Border Classes="pill accent" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding Plan.ShowBadge}">
              <TextBlock Text="{Binding Plan.Badge}" FontSize="9" FontWeight="Bold" LetterSpacing="1" />
            </Border>
            <Border Classes="pill accent" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding Updates.HasUpdate}">
              <TextBlock Text="UPDATE READY" FontSize="9" FontWeight="Bold" LetterSpacing="1" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="pill accent" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding HasSquadStatus}" Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconSquad}" Width="10" Height="10" />
                <TextBlock Text="{Binding SquadStatus}" FontSize="9" FontWeight="Bold" LetterSpacing="1" />
              </StackPanel>
            </Border>
            <Ellipse Fill="{Binding StatusBrush}" Classes="liveDot" Classes.pulsing="{Binding IsRecording}" Width="7" Height="7"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="320" />
          </StackPanel>
        </Grid>
        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Divider}" IsHitTestVisible="False" />

        <!-- Pages keep 40 px clear of the window's right edge themselves, so their scrollbars can sit on it -->
        <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="40,32,0,0">
          <TransitioningContentControl.PageTransition>
            <views:RiseTransition />
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
      </Grid>
    </Grid>

    <!-- Pop-ups: notifications in the top-right corner for a few seconds; the pointer over them keeps them up -->
    <ItemsControl Name="PopUpStack" ItemsSource="{Binding Notifications.PopUps}" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Width="360" Margin="0,54,28,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:NoticeItem">
          <Panel Margin="0,0,0,10">
            <views:Plate Classes="popUp" Cut="8" Padding="0" Background="{StaticResource OverlayBrush}"
                         BorderBrush="{DynamicResource AccentBrush}">
              <Button Classes="marker" Margin="0" Padding="12,11,38,12" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="tile small" VerticalAlignment="Top" Margin="0,2,12,0">
                    <PathIcon Data="{Binding Icon}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Bold" LetterSpacing="1.2"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                               MaxLines="3" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasText}" />
                  </StackPanel>
                </Grid>
              </Button>
            </views:Plate>
            <Button Classes="icon" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                    Command="{Binding DismissCommand}" ToolTip.Tip="Dismiss">
              <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
            </Button>
          </Panel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The notifications history, from the bell in the sidebar. A click outside closes it. -->
    <Panel IsVisible="{Binding Notifications.IsOpen}">
      <Border Name="NoticeDismiss" Background="Transparent" />
      <views:Plate Classes="card noticePanel" Width="380" MaxHeight="580" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="86,0,0,14" Padding="18,16,14,14" Background="{StaticResource OverlayBrush}"
                   BorderBrush="{StaticResource BorderStrongBrush}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="4,0,0,12">
            <TextBlock Classes="eyebrow" Text="NOTIFICATIONS" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="secondary" Padding="10,4" FontSize="12" Content="Mark all read" Margin="0,0,6,0"
                    Command="{Binding Notifications.MarkAllReadCommand}" />
            <Button Grid.Column="2" Classes="icon" Width="28" Height="28" Command="{Binding Notifications.TogglePanelCommand}"
                    ToolTip.Tip="Close">
              <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
            </Button>
          </Grid>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="4,10,0,0">
            <Button Classes="secondary" Padding="10,4" FontSize="12" Content="Choose what pops up" HorizontalAlignment="Left"
                    Command="{Binding OpenNoticeSettingsCommand}" />
            <Button Grid.Column="1" Classes="secondary" Padding="10,4" FontSize="12" Content="Clear"
                    Command="{Binding Notifications.ClearCommand}" />
          </Grid>
          <Panel>
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="4,6" IsVisible="{Binding Notifications.HasNoHistory}"
                       Text="Nothing yet. Friend requests, clips you save, your subscription renewing and other news show up here." />
            <ScrollViewer IsVisible="{Binding Notifications.HasHistory}">
              <ItemsControl ItemsSource="{Binding Notifications.History}" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NoticeItem">
                    <views:NoticeRow />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </views:Plate>
    </Panel>

    <!-- Toast -->
    <views:Plate Classes="toast" IsVisible="{Binding HasToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cut="8"
                 Margin="76,0,0,28" Padding="12,9,16,9" Background="{StaticResource OverlayBrush}"
                 BorderBrush="{DynamicResource AccentBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Classes="tile small" IsVisible="{Binding !ToastIsError}">
          <PathIcon Data="{StaticResource IconCheck}" />
        </Border>
        <Border Classes="tile small record" IsVisible="{Binding ToastIsError}">
          <PathIcon Data="{StaticResource IconAlert}" />
        </Border>
        <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                   FontWeight="SemiBold" FontSize="14" />
      </StackPanel>
    </views:Plate>
  </Panel>
</Window>
