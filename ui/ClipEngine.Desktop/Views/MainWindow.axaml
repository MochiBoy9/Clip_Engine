<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClipEngine.Desktop.ViewModels"
        xmlns:views="using:ClipEngine.Desktop.Views"
        x:Class="ClipEngine.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Clip Engine"
        Icon="avares://ClipEngine/Assets/ClipEngine.ico"
        Width="1280" Height="820" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomePage"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:ClipsPage"><views:ClipsView /></DataTemplate>
    <DataTemplate DataType="vm:GamesPage"><views:GamesView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:PlayerViewModel"><views:PlayerView /></DataTemplate>
    <DataTemplate DataType="vm:StudioViewModel"><views:StudioView /></DataTemplate>
  </Window.DataTemplates>

  <Panel Name="Root">
    <Grid ColumnDefinitions="232,*">
      <!-- Sidebar -->
      <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,14,12,12">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,26"
                      IsHitTestVisible="False">
            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
              <PathIcon Data="{StaticResource IconPlay}" Width="13" Height="13" Margin="2,0,0,0"
                        Foreground="{DynamicResource AccentForegroundBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Clip Engine" FontSize="15" FontWeight="Bold" LetterSpacing="-0.2" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Version}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
                <Border Classes="pill accent" Padding="6,0" IsVisible="{Binding Supporter.IsSupporter}"
                        ToolTip.Tip="Thanks for supporting Clip Engine">
                  <TextBlock Text="SUPPORTER" FontSize="9" FontWeight="Bold" LetterSpacing="0.6" />
                </Border>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- Engine status, always visible -->
          <Border DockPanel.Dock="Bottom" Classes="inset" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
              <Panel Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                <Ellipse Fill="{Binding StatusBrush}" Classes="liveDot" Classes.pulsing="{Binding IsRecording}" />
              </Panel>
              <TextBlock Grid.Column="1" Text="{Binding SidebarStatus}" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SaveHint}" Classes="caption" Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <!-- The slim panel that docks over the game -->
          <Button DockPanel.Dock="Bottom" Classes="marker" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Margin="0,0,0,8" Padding="12,9" Command="{Binding ToggleSidePanelCommand}"
                  ToolTip.Tip="A slim panel on the edge of the screen, over your game">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource IconPanel}" Width="15" Height="15" Margin="0,0,12,0"
                        Foreground="{StaticResource TextSecondary}" />
              <TextBlock Grid.Column="1" Text="Side panel" VerticalAlignment="Center" FontSize="13"
                         Foreground="{StaticResource TextSecondary}" />
              <Border Grid.Column="2" Classes="kbd" VerticalAlignment="Center">
                <TextBlock Text="{Binding SidePanelHotkey}" />
              </Border>
            </Grid>
          </Button>

          <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Grid ColumnDefinitions="3,Auto,*" Height="38">
                  <Border Classes="navBar" Width="3" Height="18" CornerRadius="0,2,2,0" VerticalAlignment="Center" />
                  <PathIcon Grid.Column="1" Classes="navIcon" Data="{Binding Icon}" Width="16" Height="16" Margin="11,0,12,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"
                             Foreground="{Binding $parent[ListBoxItem].Foreground}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="28,40,28,0">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.12" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>

    <!-- Toast -->
    <Border Classes="card" IsVisible="{Binding HasToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="232,0,0,24" Padding="14,10" Background="#F21A1C22" BorderBrush="{StaticResource BorderStrongBrush}"
            BoxShadow="{StaticResource FloatShadow}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Classes="tile small" IsVisible="{Binding !ToastIsError}">
          <PathIcon Data="{StaticResource IconCheck}" />
        </Border>
        <Border Classes="tile small record" IsVisible="{Binding ToastIsError}">
          <PathIcon Data="{StaticResource IconAlert}" />
        </Border>
        <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
