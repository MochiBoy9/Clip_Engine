<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Carbon: flat, opaque surfaces with one bright accent. No blur, transparency, gradients or soft shadows, so a
       redraw costs next to nothing and the app stays out of the game's way. -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ClipEngine/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Surfaces, from the back of the window to the front -->
      <SolidColorBrush x:Key="WindowBrush" Color="#0C0D10" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#101115" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#15171C" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1A1C22" />
      <SolidColorBrush x:Key="InsetBrush" Color="#0F1014" />
      <SolidColorBrush x:Key="ControlBrush" Color="#1D2027" />
      <SolidColorBrush x:Key="ControlHoverBrush" Color="#252831" />
      <SolidColorBrush x:Key="ControlPressedBrush" Color="#181A20" />
      <SolidColorBrush x:Key="OverlayBrush" Color="#F2131418" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#B3000000" />

      <!-- Lines -->
      <SolidColorBrush x:Key="BorderBrush" Color="#22252C" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#2E323B" />
      <SolidColorBrush x:Key="Divider" Color="#1E2127" />

      <!-- Text -->
      <SolidColorBrush x:Key="TextPrimary" Color="#EDEEF1" />
      <SolidColorBrush x:Key="TextSecondary" Color="#A1A6B2" />
      <SolidColorBrush x:Key="TextTertiary" Color="#6C7280" />

      <!-- States -->
      <Color x:Key="RecordColor">#FF4D6A</Color>
      <SolidColorBrush x:Key="RecordBrush" Color="#FF4D6A" />
      <SolidColorBrush x:Key="RecordSoftBrush" Color="#24FF4D6A" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#213DDC97" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FFB547" />
      <SolidColorBrush x:Key="WarnSoftBrush" Color="#24FFB547" />
      <SolidColorBrush x:Key="IdleBrush" Color="#7D8394" />

      <!-- The accent. Services/AccentThemes.cs swaps these for a supporter's colour theme, so they're looked up as
           dynamic resources. Volt is the default. -->
      <Color x:Key="AccentColor">#C5F135</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#C5F135" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#D3F562" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#AFD91F" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FC5F135" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0C0D10" />

      <!-- The only shadows left: things that float over other content -->
      <BoxShadows x:Key="FloatShadow">0 8 24 0 #66000000</BoxShadows>

      <!-- Fluent theme resources, made flat to match -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#0F1014" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#121318" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#121318" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2A2D35" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3A3E48" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#EDEEF1" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6C7280" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#1D2027" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#252831" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#181A20" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2A2D35" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3A3E48" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#17191E" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2E323B" />
      <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1D2027" />
      <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#252831" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#3A3E48" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#4A4F5A" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A1A6B2" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#EDEEF1" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0C0D10" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0C0D10" />
      <SolidColorBrush x:Key="SliderTrackFill" Color="#2A2D35" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#343843" />
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Type -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.1" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>
  <Style Selector="TextBlock.accentText">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{StaticResource InsetBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- A pill laid over a thumbnail or video -->
  <Style Selector="Border.pill.onMedia">
    <Setter Property="Background" Value="#CC0C0D10" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.pill.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Border.pill.accent PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Border.pill.record">
    <Setter Property="Background" Value="{StaticResource RecordSoftBrush}" />
    <Setter Property="BorderBrush" Value="#66FF4D6A" />
  </Style>
  <!-- A key on the keyboard, for hotkeys -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <!-- A square with an icon in the accent colour, in front of a setting or a number -->
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.tile > PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.tile.neutral">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
  </Style>
  <Style Selector="Border.tile.neutral > PathIcon">
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="Border.tile.record">
    <Setter Property="Background" Value="{StaticResource RecordSoftBrush}" />
  </Style>
  <Style Selector="Border.tile.record > PathIcon">
    <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
  </Style>
  <Style Selector="Border.tile.warn">
    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
  </Style>
  <Style Selector="Border.tile.warn > PathIcon">
    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
  </Style>
  <Style Selector="Border.tile.small">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Border.tile.small > PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>
  <Style Selector="Button.accent:disabled TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>
  <Style Selector="Button.accent:disabled PathIcon">
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    <Setter Property="BorderBrush" Value="#3A3E48" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlPressedBrush}" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>
  <!-- A button whose mode is on, like Trim while trimming -->
  <Style Selector="Button.secondary.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Starts or stops something that records, like a long recording. Red outline while idle, solid red while on. -->
  <Style Selector="Button.record">
    <Setter Property="Background" Value="{StaticResource RecordSoftBrush}" />
    <Setter Property="BorderBrush" Value="#80FF4D6A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.record:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#38FF4D6A" />
    <Setter Property="BorderBrush" Value="{StaticResource RecordBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="Button.record PathIcon">
    <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
  </Style>
  <Style Selector="Button.record.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource RecordBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RecordBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.record.active PathIcon">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    <Setter Property="BorderBrush" Value="#3A3E48" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlPressedBrush}" />
  </Style>
  <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource RecordBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RecordBrush}" />
  </Style>
  <!-- Icon buttons laid over a thumbnail -->
  <Style Selector="Button.icon.onMedia">
    <Setter Property="Background" Value="#CC0C0D10" />
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <!-- Segmented choice, like the codec -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Segment" Background="Transparent" CornerRadius="6" Padding="14,6">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                            TextElement.FontWeight="Medium" TextElement.FontSize="13" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#PART_Segment">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- The box segments sit in -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{StaticResource InsetBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <!-- Filter chips -->
  <Style Selector="RadioButton.chip, ToggleButton.chip">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Chip" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="999" Padding="13,5">
          <ContentPresenter Content="{TemplateBinding Content}" TextElement.FontSize="13"
                            TextElement.FontWeight="Medium" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="RadioButton.chip:pointerover /template/ Border#PART_Chip, ToggleButton.chip:pointerover /template/ Border#PART_Chip">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.chip:checked, ToggleButton.chip:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.chip:checked /template/ Border#PART_Chip, ToggleButton.chip:checked /template/ Border#PART_Chip">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Filter chips as a horizontal list -->
  <Style Selector="ListBox.chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.chips ListBoxItem">
    <Setter Property="Padding" Value="13,5" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Detection Studio's rule list -->
  <Style Selector="ListBox.rules">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rules ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.rules ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rules ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.rules ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>

  <!-- Sidebar navigation: a bar in the accent colour marks the page you're on -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem Border.navBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Border.navBar">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem PathIcon.navIcon">
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover PathIcon.navIcon">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected PathIcon.navIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!-- A pulsing red dot while recording. Only its opacity animates, which is cheap to redraw. -->
  <Style Selector="Ellipse.liveDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{StaticResource RecordBrush}" />
  </Style>
  <Style Selector="Ellipse.liveDot.pulsing">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Clip cards light their edge and show their actions on hover -->
  <Style Selector="Border.clipCard">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Border.clipCard:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Border.clipCard Panel.hoverActions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.clipCard:pointerover Panel.hoverActions, Border.clipCard.showActions Panel.hoverActions">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Rows in the player's list of moments -->
  <Style Selector="Button.marker">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="Button.marker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.marker:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
  </Style>
</Styles>
