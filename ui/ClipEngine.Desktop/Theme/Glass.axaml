<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ClipEngine/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Text -->
      <SolidColorBrush x:Key="TextPrimary" Color="#F4F6FF" />
      <SolidColorBrush x:Key="TextSecondary" Color="#B4BCD8" />
      <SolidColorBrush x:Key="TextTertiary" Color="#7E87A8" />

      <!-- States -->
      <Color x:Key="RecordColor">#FF4D7A</Color>
      <SolidColorBrush x:Key="RecordBrush" Color="#FF4D7A" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#3EE0A6" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FFC24B" />
      <SolidColorBrush x:Key="IdleBrush" Color="#8E97B8" />

      <!-- The violet, indigo and cyan gradient used for anything primary. -->
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#B45CF6" />
        <GradientStop Offset="0.5" Color="#6C63FF" />
        <GradientStop Offset="1" Color="#22C8EE" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#C27BFA" />
        <GradientStop Offset="0.5" Color="#8580FF" />
        <GradientStop Offset="1" Color="#4AD6F3" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="RecordGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FF6A88" />
        <GradientStop Offset="1" Color="#FF3D6E" />
      </LinearGradientBrush>

      <!-- Glass: a brighter top edge, like light catching a curved surface, fading toward the bottom. -->
      <LinearGradientBrush x:Key="GlassFill" StartPoint="0%,0%" EndPoint="40%,100%">
        <GradientStop Offset="0" Color="#2EFFFFFF" />
        <GradientStop Offset="0.42" Color="#14FFFFFF" />
        <GradientStop Offset="1" Color="#0AFFFFFF" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="GlassFillHover" StartPoint="0%,0%" EndPoint="40%,100%">
        <GradientStop Offset="0" Color="#3DFFFFFF" />
        <GradientStop Offset="0.42" Color="#1FFFFFFF" />
        <GradientStop Offset="1" Color="#12FFFFFF" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="GlassStroke" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#80FFFFFF" />
        <GradientStop Offset="0.35" Color="#1AFFFFFF" />
        <GradientStop Offset="0.7" Color="#0FFFFFFF" />
        <GradientStop Offset="1" Color="#4DFFFFFF" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="GlassInset" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="GlassInsetStroke" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="Divider" Color="#17FFFFFF" />

      <BoxShadows x:Key="GlassShadow">0 18 48 0 #52000010, inset 0 1 0 0 #4DFFFFFF</BoxShadows>
      <BoxShadows x:Key="GlassShadowSoft">0 10 28 0 #3D000010, inset 0 1 0 0 #40FFFFFF</BoxShadows>
      <BoxShadows x:Key="AccentGlow">0 10 30 0 #807C5CFF, inset 0 1 0 0 #80FFFFFF</BoxShadows>
      <BoxShadows x:Key="AccentGlowStrong">0 14 40 0 #A07C5CFF, inset 0 1 0 0 #99FFFFFF</BoxShadows>
      <BoxShadows x:Key="RecordGlow">0 0 18 2 #A0FF4D7A</BoxShadows>

      <!-- Fluent theme resources that would otherwise draw opaque grey boxes. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#40FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#A08B7CFF" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F4F6FF" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#40FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F01A1730" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#33FFFFFF" />
      <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Type -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>

  <!-- Glass surfaces -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{StaticResource GlassFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BoxShadow" Value="{StaticResource GlassShadow}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.glass.soft">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="BoxShadow" Value="{StaticResource GlassShadowSoft}" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{StaticResource GlassInset}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassInsetStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="#1AFFFFFF" />
    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="BorderBrush" Value="#55FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="20,11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{StaticResource AccentGlow}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradientHover}" />
    <Setter Property="BorderBrush" Value="#80FFFFFF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BoxShadow" Value="{StaticResource AccentGlowStrong}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="#80FFFFFF" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="Button.glass">
    <Setter Property="Background" Value="{StaticResource GlassFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GlassFillHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="Button.glass:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GlassFill}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="#26000000" />
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40FFFFFF" />
    <Setter Property="BorderBrush" Value="#59FFFFFF" />
  </Style>
  <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#CCFF4D7A" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Segmented choice (codec) -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Segment" Background="Transparent" CornerRadius="10" Padding="16,7">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                            TextElement.FontWeight="Medium" TextElement.FontSize="13" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#PART_Segment">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#PART_Segment">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #667C5CFF, inset 0 1 0 0 #66FFFFFF" />
  </Style>

  <!-- Filter chips (clip library) -->
  <Style Selector="RadioButton.chip">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Chip" Background="#0FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                CornerRadius="999" Padding="14,6">
          <ContentPresenter Content="{TemplateBinding Content}" TextElement.FontSize="13"
                            TextElement.FontWeight="Medium" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="RadioButton.chip:pointerover /template/ Border#PART_Chip">
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="RadioButton.chip:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="RadioButton.chip:checked /template/ Border#PART_Chip">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
  </Style>

  <!-- Filter chips as a horizontal list -->
  <Style Selector="ListBox.chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.chips ListBoxItem">
    <Setter Property="Padding" Value="15,7" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="#26FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #667C5CFF, inset 0 1 0 0 #66FFFFFF" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GlassFillHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
    <Setter Property="BoxShadow" Value="0 8 22 0 #33000010, inset 0 1 0 0 #4DFFFFFF" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem Border.navGlyph">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Border.navGlyph">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #807C5CFF" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!-- A pulsing red dot while recording -->
  <Style Selector="Ellipse.liveDot">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Fill" Value="{StaticResource RecordBrush}" />
  </Style>
  <Style Selector="Ellipse.liveDot.pulsing">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Clip cards lift a little and show their actions on hover -->
  <Style Selector="Border.clipCard">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.clipCard:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-3px)" />
    <Setter Property="Background" Value="{StaticResource GlassFillHover}" />
  </Style>
  <Style Selector="Border.clipCard Panel.hoverActions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.clipCard:pointerover Panel.hoverActions, Border.clipCard.showActions Panel.hoverActions">
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
